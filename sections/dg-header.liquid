<header class="hdr" id="dg-header">
  <div class="wrap hdr-in">
    <!-- Left: Navigation (Desktop) / Hamburger (Mobile) -->
    <div class="nav-l">
      <button class="ibtn menu-btn" id="dgMenuBtn" aria-label="Open navigation menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h10"/></svg>
      </button>

      <nav class="nav" aria-label="Main Navigation">
        <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}">Shop All</a>
        <button id="dgMegaTrigger" type="button" aria-expanded="false" aria-controls="dgMega">
          Collections 
          <svg class="chevron" width="12" height="8" viewBox="0 0 12 8"><path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="2" fill="none"/></svg>
        </button>
        <a href="/pages/build-a-set">Build a Set</a>
        <a href="/pages/gifting">Gifting</a>
        <a href="/pages/our-story">Our Story</a>
      </nav>
    </div>

    <!-- Center: Brand Logo -->
    <a class="logo" href="/" aria-label="Drunken Glass Home">
      <span class="d" style="color:var(--blue, #2765fa)">drunken</span>
      <span class="g" style="color:var(--berry, #ef426f)">glass</span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 1c1 7 4 10 11 11-7 1-10 4-11 11-1-7-4-10-11-11 7-1 10-4 11-11z"/></svg>
    </a>

    <!-- Right: Utility Controls (Search, Account, Wishlist, Bag) -->
    <div class="util">
      <button class="searchbtn" id="dgSearchTrigger" type="button" aria-label="Open search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M20 20l-4.6-4.6"/></svg>
        <span class="t">Search glasses...</span>
      </button>

      {%- if shop.customer_accounts_enabled -%}
        <a class="ibtn hide-m" href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" aria-label="Account">
          {%- if customer -%}
            <span class="mono" style="font-size:14px;font-weight:700">{{ customer.first_name | slice: 0 | upcase }}</span>
          {%- else -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><circle cx="12" cy="8" r="4"/><path d="M4 21c1-4.5 4-6.5 8-6.5s7 2 8 6.5"/></svg>
          {%- endif -%}
        </a>
      {%- endif -%}

      <a class="ibtn hide-m" href="/pages/wishlist" aria-label="Wishlist">
        <svg viewBox="0 0 24 24"><path d="M12 20s-7.5-4.6-9.2-9.3C1.6 7.3 3.8 4 7.3 4c2 0 3.5 1.1 4.7 2.8C13.2 5.1 14.7 4 16.7 4c3.5 0 5.7 3.3 4.5 6.7C19.5 15.4 12 20 12 20z" fill="none" stroke="currentColor" stroke-width="2.2"/></svg>
        <span class="dot" id="dgWishCount" style="display:none;"></span>
      </a>

      <!-- Bag Button with Responsive Pill on Desktop, Icon on Mobile -->
      <button class="bagbtn" id="dgBagBtn" type="button" aria-label="Open bag">
        <svg class="bi" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round">
          <path d="M5 8h14l-1 13H6z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>
        </svg>
        <span class="lbl">Bag</span>
        <span class="mono" id="dgBagCount">{{ cart.item_count | default: 0 | prepend: '00' | slice: -2, 2 }}</span>
      </button>
    </div>
  </div>

  <!-- Interactive Slide-Down Search Bar -->
  <div class="search-drawer" id="dgSearchDrawer" style="display:none;position:absolute;top:100%;left:0;right:0;background:var(--paper);border-bottom:2px solid var(--ink);padding:14px 16px;box-shadow:0 8px 24px rgba(0,0,0,0.08);z-index:95">
    <div class="wrap" style="max-width:760px;margin:0 auto">
      <form action="{{ routes.search_url }}" method="get" role="search" style="display:flex;gap:8px;align-items:center">
        <div style="flex:1;position:relative;display:flex;align-items:center">
          <svg style="position:absolute;left:14px;width:18px;height:18px;color:var(--muted);pointer-events:none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M20 20l-4.6-4.6"/></svg>
          <input type="search" name="q" id="dgSearchInput" placeholder="Search glasses, tumblers, mugs, collections..." style="width:100%;min-height:46px;padding:0 16px 0 42px;border:2px solid var(--ink);border-radius:999px;font:500 14px var(--f-body);background:#fff;box-sizing:border-box">
        </div>
        <button type="submit" class="btn btn-blue sm" style="min-height:46px;padding:0 20px;flex-shrink:0">Search</button>
        <button type="button" id="dgCloseSearch" class="ibtn" aria-label="Close search" style="flex-shrink:0">✕</button>
      </form>
      <div style="display:flex;gap:8px;align-items:center;margin-top:10px;flex-wrap:wrap">
        <span style="font-size:12px;color:var(--muted);font-weight:700">Quick Searches:</span>
        <a class="chip" href="/collections/tumblers" style="height:26px;font-size:12px;padding:0 10px">Tumblers</a>
        <a class="chip" href="/collections/mugs" style="height:26px;font-size:12px;padding:0 10px">Mugs</a>
        <a class="chip" href="/collections/cocktail-glasses" style="height:26px;font-size:12px;padding:0 10px">Coupes</a>
        <a class="chip" href="/pages/build-a-set" style="height:26px;font-size:12px;padding:0 10px">Build a Set ($99)</a>
      </div>
    </div>
  </div>

  <!-- Mega Menu Dropdown -->
  <div class="mega" id="dgMega">
    <div class="mega-in">
      <div>
        <h4>Glassware Categories</h4>
        <div class="mega-cols">
          <a class="mcol" href="/collections/tumblers" style="--bg:#f8fac4">
            <img src="{{ 'r3-r3tu113.webp' | asset_url }}" alt="Tumblers" width="48" height="48" loading="lazy" style="object-fit:contain">
            <span>Tumblers</span>
          </a>
          <a class="mcol" href="/collections/mugs" style="--bg:#ffe1e8">
            <img src="{{ 'r3-r3tc117.webp' | asset_url }}" alt="Mugs & Cups" width="48" height="48" loading="lazy" style="object-fit:contain">
            <span>Mugs & Cups</span>
          </a>
          <a class="mcol" href="/collections/double-glass" style="--bg:#f2f1f0">
            <img src="{{ 'r3-r3dg107.webp' | asset_url }}" alt="Double Wall" width="48" height="48" loading="lazy" style="object-fit:contain">
            <span>Double Wall</span>
          </a>
          <a class="mcol" href="/collections/cocktail-glasses" style="--bg:#dfe8ff">
            <img src="{{ 'r3-r3co240.webp' | asset_url }}" alt="Cocktail Coupes" width="48" height="48" loading="lazy" style="object-fit:contain">
            <span>Cocktails</span>
          </a>
          <a class="mcol" href="/collections/wine-glasses" style="--bg:#eaef29">
            <img src="{{ 'r3-r3wg237.webp' | asset_url }}" alt="Wine Glasses" width="48" height="48" loading="lazy" style="object-fit:contain">
            <span>Wine Glasses</span>
          </a>
          <a class="mcol" href="/collections/all" style="--bg:#ffffff;justify-content:center">
            <span style="font:400 20px var(--f-display)">All Glasses</span>
          </a>
        </div>
      </div>
      <div class="mega-list">
        <h4>Shop By Type</h4>
        <a href="/collections/tumblers">Tumblers</a>
        <a href="/collections/mugs">Mugs</a>
        <a href="/collections/espresso-tea">Espresso + Tea</a>
        <a href="/collections/cocktail-glasses">Cocktail Glasses</a>
        <a href="/collections/sets-and-accessories">Sets & Accessories</a>
        <a href="/pages/build-a-set">Build a Set</a>
      </div>
      <a class="mega-promo" href="/pages/quiz">
        <b>Which Glass Are You?</b>
        <span>3 quick questions. One perfect glass. Zero commitment issues.</span>
        <span class="btn btn-lime sm" style="align-self:flex-start">Take the Quiz</span>
      </a>
    </div>
  </div>
</header>

<!-- Mobile Menu Drawer -->
<aside class="drawer left dg-drawer" id="dgMobileMenu" aria-label="Menu" aria-hidden="true">
  <div class="dhead">
    <h3>Menu</h3>
    <button class="close" id="dgCloseMenu" aria-label="Close menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>
  <div class="dbody">
    <nav class="mnav" aria-label="mobile">
      <a href="/collections/all">Shop All</a>
      <a href="/pages/build-a-set">Build a Set</a>
      <a href="/pages/gifting">Gifting</a>
      <a href="/products/digital-gift-card">Gift Cards</a>
      <a href="/pages/quiz">Which Glass Are You?</a>
      <a href="/pages/our-story">Our Story</a>
    </nav>
    <p class="lbl" style="margin:16px 0 8px;font:700 13px var(--f-head);color:var(--muted)">Collections</p>
    <div class="mnav-cols">
      <a class="mcol" href="/collections/fruit-club" style="--bg:#ffe1e8"><span>Fruit Club</span></a>
      <a class="mcol" href="/collections/heart-eyes" style="--bg:#ffe1e8"><span>Heart Eyes</span></a>
      <a class="mcol" href="/collections/golden-hour" style="--bg:#f8fac4"><span>Golden Hour</span></a>
      <a class="mcol" href="/collections/the-wobble" style="--bg:#dfe8ff"><span>The Wobble</span></a>
      <a class="mcol" href="/collections/cafe-club" style="--bg:#f2f1f0"><span>Café Club</span></a>
      <a class="mcol" href="/collections/after-hours" style="--bg:#dfe8ff"><span>After Hours</span></a>
      <a class="mcol" href="/collections/y2k-bloom" style="--bg:#ffe1e8"><span>Y2K Bloom</span></a>
    </div>
  </div>
</aside>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const megaBtn = document.getElementById('dgMegaTrigger');
  const megaMenu = document.getElementById('dgMega');
  const menuBtn = document.getElementById('dgMenuBtn');
  const mobileMenu = document.getElementById('dgMobileMenu');
  const closeMenu = document.getElementById('dgCloseMenu');
  const searchBtn = document.getElementById('dgSearchTrigger');
  const searchDrawer = document.getElementById('dgSearchDrawer');
  const closeSearch = document.getElementById('dgCloseSearch');
  const searchInput = document.getElementById('dgSearchInput');
  const scrim = document.getElementById('dgScrim');

  // Mega Menu Toggle
  if (megaBtn && megaMenu) {
    megaBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      const open = megaMenu.classList.toggle('open');
      megaBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (searchDrawer) searchDrawer.style.display = 'none';
    });

    document.addEventListener('click', function(e) {
      if (!megaMenu.contains(e.target) && !megaBtn.contains(e.target)) {
        megaMenu.classList.remove('open');
        megaBtn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  // Interactive Search Drawer Toggle
  if (searchBtn && searchDrawer) {
    searchBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      const isOpen = searchDrawer.style.display === 'block';
      searchDrawer.style.display = isOpen ? 'none' : 'block';
      if (!isOpen && searchInput) {
        setTimeout(() => searchInput.focus(), 100);
      }
      if (megaMenu) {
        megaMenu.classList.remove('open');
        if (megaBtn) megaBtn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  if (closeSearch && searchDrawer) {
    closeSearch.addEventListener('click', function() {
      searchDrawer.style.display = 'none';
    });
  }

  // Mobile Drawer Toggle
  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', function() {
      mobileMenu.classList.add('open');
      mobileMenu.setAttribute('aria-hidden', 'false');
      if (scrim) scrim.classList.add('open');
    });
  }

  if (closeMenu && mobileMenu) {
    closeMenu.addEventListener('click', function() {
      mobileMenu.classList.remove('open');
      mobileMenu.setAttribute('aria-hidden', 'true');
      if (scrim) scrim.classList.remove('open');
    });
  }

  // Close search on escape
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && searchDrawer && searchDrawer.style.display === 'block') {
      searchDrawer.style.display = 'none';
    }
  });
});
</script>

