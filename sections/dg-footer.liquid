<footer class="ftr" id="dg-footer">
  <div class="wrap">
    <!-- Brand Wordmark Header -->
    <div class="ftr-head">
      <div class="ftr-wordmark">
        <span class="d">drunken</span>
        <span class="g">glass</span>
        <svg class="ftr-sparkle" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 1c1 7 4 10 11 11-7 1-10 4-11 11-1-7-4-10-11-11 7-1 10-4 11-11z"/></svg>
      </div>
      <p class="ftr-tagline">Bold borosilicate glassware made to turn heads. Handcrafted in India, enjoyed worldwide.</p>
    </div>

    <!-- 5 Columns Grid (2-column balanced grid on mobile, 5 columns on desktop) -->
    <div class="ftr-cols">
      <!-- Col 1: Shop -->
      <div class="ftr-col">
        <h4>Shop</h4>
        <ul>
          <li><a href="/collections/all">All Glasses</a></li>
          <li><a href="/collections/tumblers">Tumblers</a></li>
          <li><a href="/collections/mugs">Mugs</a></li>
          <li><a href="/collections/espresso-tea">Espresso + Tea</a></li>
          <li><a href="/collections/cocktail-glasses">Cocktail Glasses</a></li>
          <li><a href="/pages/build-a-set">Build a Set ($99)</a></li>
          <li><a href="/products/digital-gift-card">Digital Gift Cards</a></li>
        </ul>
      </div>

      <!-- Col 2: Categories -->
      <div class="ftr-col">
        <h4>Glassware</h4>
        <ul>
          <li><a href="/collections/tumblers">Tumbler Glasses</a></li>
          <li><a href="/collections/mugs">Mugs & Cups</a></li>
          <li><a href="/collections/cocktail-glasses">Cocktail Coupes</a></li>
          <li><a href="/collections/double-glass">Double Wall Glasses</a></li>
          <li><a href="/collections/wine-glasses">Wine Glasses</a></li>
          <li><a href="/collections/espresso-tea">Espresso & Tea</a></li>
          <li><a href="/collections/all">All Glasses</a></li>
        </ul>
      </div>

      <!-- Col 3: About -->
      <div class="ftr-col">
        <h4>About</h4>
        <ul>
          <li><a href="/pages/our-story">Our Story</a></li>
          <li><a href="/pages/our-story#craft">The Furnace Process</a></li>
          <li><a href="/pages/quiz">Style Quiz</a></li>
          <li><a href="/pages/gifting">Gifting Hub</a></li>
        </ul>
      </div>

      <!-- Col 4: Help -->
      <div class="ftr-col">
        <h4>Help</h4>
        <ul>
          <li><a href="/pages/track-order">Track Order</a></li>
          <li><a href="/pages/help">FAQ & Care</a></li>
          <li><a href="/policies/shipping-policy">Shipping & Returns</a></li>
          <li><a href="/pages/help#breakage">Breakage Care</a></li>
          <li><a href="/pages/help#contact">Contact Us</a></li>
        </ul>
      </div>

      <!-- Col 5: Legal -->
      <div class="ftr-col ftr-col-wide">
        <h4>Legal</h4>
        <ul>
          <li><a href="/policies/privacy-policy">Privacy Policy</a></li>
          <li><a href="/policies/terms-of-service">Terms of Service</a></li>
          <li><a href="/policies/refund-policy">Refund Policy</a></li>
          <li><a href="/policies/privacy-policy#do-not-sell">Do Not Sell My Info</a></li>
          <li><a href="/pages/accessibility">Accessibility</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar: Payments & Copyright -->
    <div class="ftr-bot">
      <p class="ftr-copy">© {{ 'now' | date: '%Y' }} Drunken Glass. All Rights Reserved. Prices in USD.</p>
      <div class="ftr-chips">
        <span class="chip sm">Shop Pay</span>
        <span class="chip sm">Apple Pay</span>
        <span class="chip sm">Google Pay</span>
        <span class="chip sm">PayPal</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "DG Footer",
  "settings": [],
  "presets": [
    {
      "name": "DG Footer"
    }
  ]
}
{% endschema %}
