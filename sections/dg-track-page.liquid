<section class="wrap sec" style="max-width:680px;padding-top:16px" id="dg-track-page">
  <header class="page-head" style="margin-bottom:28px">
    <span class="badge b-lime" style="display:inline-block;margin-bottom:8px">live updates</span>
    <h1 class="h2">where’s my glass?</h1>
    <p class="sub">enter your order number and email to see where your package is on its journey.</p>
  </header>

  <div style="background:#fff;border:2px solid var(--ink);border-radius:var(--r);box-shadow:var(--sh);padding:clamp(20px,5vw,36px)">
    <form id="dgTrackForm" style="display:flex;flex-direction:column;gap:16px">
      <div>
        <label style="font:700 13px var(--f-head);display:block;margin-bottom:6px">order number *</label>
        <input type="text" id="dgTrackNum" placeholder="e.g. DG-10492" required style="width:100%;border:2px solid var(--ink);border-radius:var(--r);padding:10px 14px;font:500 15px var(--f-mono)">
      </div>
      <div>
        <label style="font:700 13px var(--f-head);display:block;margin-bottom:6px">email address *</label>
        <input type="email" id="dgTrackEmail" placeholder="the email used at checkout" required style="width:100%;border:2px solid var(--ink);border-radius:var(--r);padding:10px 14px;font-size:14px">
      </div>
      <button class="btn btn-blue" type="submit" style="min-height:50px;font-size:16px">track order</button>
    </form>

    <div id="dgTrackStatus" style="display:none;margin-top:24px;border-top:2px solid var(--ink);padding-top:20px">
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px">
        <span class="badge b-lime" style="position:static">in transit</span>
        <b style="font-size:15px">out for US delivery</b>
      </div>
      <p style="font-size:14px;color:var(--muted)">estimated delivery by end of day tomorrow. safely packed in our signature shockproof box.</p>
    </div>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const form = document.getElementById('dgTrackForm');
  const status = document.getElementById('dgTrackStatus');
  if (form && status) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      status.style.display = 'block';
    });
  }
});
</script>

{% schema %}
{
  "name": "DG Track Page",
  "settings": [],
  "presets": [
    {
      "name": "DG Track Page"
    }
  ]
}
{% endschema %}
