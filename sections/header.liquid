<!-- Drunken Glass Branded Header -->
<!-- Announcement bar -->
<div class="dg-announce">
  {%- if section.settings.announcement_1 != blank -%}
    <span>{{ section.settings.announcement_1 }}</span>
  {%- endif -%}
  {%- if section.settings.announcement_2 != blank -%}
    <span>{{ section.settings.announcement_2 }}</span>
  {%- endif -%}
</div>

<!-- Scrolling ticker -->
<div class="dg-ticker" aria-hidden="true">
  <div class="run">
    <span>Made at our furnace <span class="dot">✦</span> Sold direct <span class="dot">✦</span> 15 years of borosilicate <span class="dot">✦</span> Never watered down <span class="dot">✦</span> Home &amp; trade <span class="dot">✦</span> Made at our furnace <span class="dot">✦</span> Sold direct <span class="dot">✦</span> 15 years of borosilicate <span class="dot">✦</span> Never watered down <span class="dot">✦</span> Home &amp; trade <span class="dot">✦</span></span>
  </div>
</div>

<!-- Main navigation -->
<nav class="dg-nav" role="navigation" aria-label="Main navigation">
  <div class="dg-nav-in">
    <a href="{{ routes.root_url }}" class="dg-brand streak" aria-label="{{ shop.name }}">
      {{ section.settings.brand_name | default: 'Drunken Glass' }}
    </a>

    <ul class="dg-nav-links">
      {%- for link in section.settings.menu.links -%}
        <li class="hide-sm">
          <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>
            {{ link.title }}
          </a>
        </li>
      {%- endfor -%}
      <li>
        <a href="{{ routes.cart_url }}" class="cart-link" id="cart-icon-link" aria-label="Cart ({{ cart.item_count }} items)">
          Cart
          {%- if cart.item_count > 0 -%}
            <span class="dg-cart-count">&nbsp;({{ cart.item_count }})</span>
          {%- endif -%}
        </a>
      </li>
    </ul>

    <button class="dg-navtoggle" id="dg-navtoggle" aria-label="Open menu" aria-expanded="false" aria-controls="dg-mobmenu">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<!-- Mobile menu -->
<div class="dg-mobmenu" id="dg-mobmenu" aria-hidden="true">
  <a href="{{ routes.root_url }}">Home</a>
  {%- for link in section.settings.menu.links -%}
    <a href="{{ link.url }}">{{ link.title }}</a>
  {%- endfor -%}
  <a href="{{ routes.cart_url }}">Cart ({{ cart.item_count }})</a>
</div>

<script>
(function(){
  var t = document.getElementById('dg-navtoggle');
  var m = document.getElementById('dg-mobmenu');
  if (!t || !m) return;
  t.addEventListener('click', function() {
    var open = m.classList.toggle('on');
    t.setAttribute('aria-expanded', open ? 'true' : 'false');
    m.setAttribute('aria-hidden', open ? 'false' : 'true');
  });
})();
</script>

{% schema %}
{
  "name": "Drunken Glass Header",
  "class": "shopify-section-group-header-section",
  "limit": 1,
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "Drunken Glass"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "announcement_1",
      "label": "Announcement 1",
      "default": "Free shipping on all orders"
    },
    {
      "type": "text",
      "id": "announcement_2",
      "label": "Announcement 2",
      "default": "Pay online — skip COD charges & take 5% extra off"
    }
  ]
}
{% endschema %}
