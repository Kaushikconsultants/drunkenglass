<section class="wrap hero" id="dg-hero">
  <div class="hero-copy">
    <a class="hero-pill" href="/pages/gifting">
      <i>new</i> the holiday gift shop is open
    </a>
    
    <h1 class="tipsy">
      <span style="--r:-3deg;--i:0">your</span> 
      <span style="--r:2deg;--i:1">drink</span> 
      <span style="--r:-1.5deg;--i:2">deserves</span> 
      <span style="--r:2.5deg;--i:3">a better</span> 
      <span style="--r:-2deg;--i:4">outfit.</span>
    </h1>

    <p class="hero-sub">
      designer borosilicate glasses shaped like strawberries, hearts, waves and sunsets. made in our own furnace and built for hot coffee and iced everything.
    </p>

    <div class="hero-cta">
      <a class="btn btn-blue" href="/collections/all">shop all glasses</a>
      <a class="btn btn-lime" href="/pages/quiz">find my glass</a>
    </div>

    <ul class="hero-trust">
      <li>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 2c1 5 6 7 6 12a6 6 0 1 1-12 0c0-5 5-7 6-12z"/></svg>
        hot + cold safe
      </li>
      <li>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 2l2.4 7.2h7.6l-6.1 4.5 2.3 7.3-6.2-4.6-6.2 4.6 2.3-7.3-6.1-4.5h7.6z"/></svg>
        15 years of glassmaking
      </li>
      <li>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="1" y="4" width="15" height="13" rx="2"/><path d="M16 8h4l3 4v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        free US shipping over $75
      </li>
    </ul>
  </div>

  <div class="lens" id="lens">
    <!-- Optical Refraction Glass SVG -->
    <svg class="lens-svg" viewBox="0 0 600 600" role="img" aria-label="clear can glass with optical refraction lens">
      <defs>
        <pattern id="hs" width="60" height="600" patternUnits="userSpaceOnUse">
          <rect width="30" height="600" fill="#eaef29"/>
        </pattern>
        <clipPath id="hGlass">
          <path d="M64 64 Q64 54 74 52 L126 52 Q136 54 136 64 L142 78 L142 224 Q142 236 130 236 L70 236 Q58 236 58 224 L58 78 Z" transform="translate(90 58) scale(2.1)"/>
        </clipPath>
        <clipPath id="hLiq">
          <path id="liqClipPath" d="M100 330Q150 322 200 330T300 330T400 330T500 330L500 640L100 640Z"/>
        </clipPath>
        <linearGradient id="hShade" gradientUnits="userSpaceOnUse" x1="212" x2="388">
          <stop offset="0" stop-color="#0a0a0a" stop-opacity=".38"/>
          <stop offset=".2" stop-color="#0a0a0a" stop-opacity="0"/>
          <stop offset=".8" stop-color="#0a0a0a" stop-opacity="0"/>
          <stop offset="1" stop-color="#0a0a0a" stop-opacity=".32"/>
        </linearGradient>
        <g id="hStraw">
          <line x1="380" y1="24" x2="290" y2="520" stroke="#0a0a0a" stroke-width="32" stroke-linecap="round"/>
          <line x1="380" y1="24" x2="290" y2="520" stroke="#ffffff" stroke-width="23" stroke-linecap="round"/>
          <line x1="380" y1="24" x2="290" y2="520" stroke="#ef426f" stroke-width="23" stroke-dasharray="20 16"/>
        </g>
      </defs>
      <rect width="600" height="600" fill="#2765fa"/>
      <rect x="-60" width="720" height="600" fill="url(#hs)"/>
      <ellipse cx="300" cy="566" rx="128" ry="14" fill="#0a0a0a" fill-opacity=".3"/>
      <g id="tilt">
        <use href="#hStraw"/>
        <g clip-path="url(#hGlass)">
          <g id="refTop">
            <rect x="-400" width="1400" height="600" fill="#2765fa"/>
            <rect x="-400" width="1400" height="600" fill="url(#hs)"/>
          </g>
          <rect width="600" height="600" fill="#ffffff" fill-opacity=".14"/>
          <use href="#hStraw"/>
          <g clip-path="url(#hLiq)">
            <g id="refLiq">
              <rect x="-400" width="1400" height="600" fill="#2765fa"/>
              <rect x="-400" width="1400" height="600" fill="url(#hs)"/>
            </g>
            <rect width="600" height="600" fill="#ef426f" fill-opacity=".3"/>
            <g id="strawLiq"><use href="#hStraw"/></g>
            <rect x="236" y="372" width="54" height="54" rx="10" transform="rotate(-16 263 399)" fill="#ffffff" fill-opacity=".55" stroke="#0a0a0a" stroke-width="4"/>
            <rect x="312" y="420" width="48" height="48" rx="10" transform="rotate(12 336 444)" fill="#ffffff" fill-opacity=".5" stroke="#0a0a0a" stroke-width="4"/>
          </g>
          <path id="surfLine" d="M150 330Q200 321 250 330T350 330T450 330" stroke="#0a0a0a" stroke-width="4" fill="none"/>
          <rect width="600" height="600" fill="url(#hShade)"/>
          <rect x="232" y="200" width="17" height="300" rx="8.5" fill="#ffffff" fill-opacity=".75"/>
          <rect x="259" y="214" width="6" height="170" rx="3" fill="#ffffff" fill-opacity=".55"/>
        </g>
        <path d="M64 64 Q64 54 74 52 L126 52 Q136 54 136 64 L142 78 L142 224 Q142 236 130 236 L70 236 Q58 236 58 224 L58 78 Z" transform="translate(90 58) scale(2.1)" fill="none" stroke="#0a0a0a" stroke-width="2.3" stroke-linejoin="round"/>
        <ellipse cx="300" cy="168" rx="56" ry="7" fill="#ffffff" fill-opacity=".35" stroke="#0a0a0a" stroke-width="4.5"/>
      </g>
    </svg>

    <!-- Spinning Badge -->
    <svg class="spin" viewBox="0 0 120 120" aria-hidden="true">
      <defs>
        <path id="spinP" d="M60 60m-43 0a43 43 0 1 1 86 0a43 43 0 1 1-86 0"/>
      </defs>
      <circle cx="60" cy="60" r="58" fill="#eaef29" stroke="#0a0a0a" stroke-width="2.5"/>
      <text font-family="Space Grotesk, sans-serif" font-weight="700" font-size="10.6" letter-spacing=".6" fill="#0a0a0a">
        <textPath href="#spinP">borosilicate ✦ hot + cold safe ✦ made to show off ✦</textPath>
      </text>
      <path d="M60 42c1.3 10 4.6 13.4 15 15-10.4 1.6-13.7 5-15 15-1.3-10-4.6-13.4-15-15 10.4-1.6 13.7-5 15-15z" fill="#ef426f" stroke="#0a0a0a" stroke-width="2"/>
    </svg>

    <span class="lens-tag mouse">move your cursor over the glass</span>
    <span class="lens-tag touch">it sways on its own. like after two drinks.</span>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const lens = document.getElementById('lens');
  if (!lens) return;

  const tilt = document.getElementById('tilt');
  const refTop = document.getElementById('refTop');
  const refLiq = document.getElementById('refLiq');
  const clip = document.getElementById('liqClipPath');
  const straw = document.getElementById('strawLiq');
  const surf = document.getElementById('surfLine');

  if (!tilt || !refTop || !refLiq) return;

  const touch = window.matchMedia('(hover: none)').matches;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let tx = 0, x = 0;
  let lensRAF = 0;

  lens.addEventListener('pointermove', function(e) {
    if (e.pointerType === 'touch') return;
    const r = lens.getBoundingClientRect();
    tx = Math.max(-1, Math.min(1, ((e.clientX - r.left) / r.width - 0.5) * 2.2));
  });

  lens.addEventListener('pointerleave', function() {
    tx = 0;
  });

  const paint = function(v) {
    const a = v * 6;
    const cr = `rotate(${(-a).toFixed(2)} 300 560)`;
    tilt.setAttribute('transform', `rotate(${a.toFixed(2)} 300 560)`);
    refTop.setAttribute('transform', `${cr} translate(${(300 + v * 12).toFixed(1)} 0) scale(1.1 1) translate(-300 0)`);
    refLiq.setAttribute('transform', `${cr} translate(${(300 - v * 70).toFixed(1)} 0) scale(-1.85 1) translate(-300 0)`);
    if (clip) clip.setAttribute('transform', cr);
    if (surf) surf.setAttribute('transform', cr);
    if (straw) straw.setAttribute('transform', `translate(${(34 - v * 16).toFixed(1)} 0)`);
  };

  paint(0);
  if (reducedMotion) return;

  const t0 = performance.now();
  const frame = function(now) {
    if (!document.body.contains(lens)) return;
    if (touch) tx = Math.sin((now - t0) / 1500) * 0.75;
    x += (tx - x) * 0.07;
    paint(x);
    lensRAF = requestAnimationFrame(frame);
  };
  lensRAF = requestAnimationFrame(frame);
});
</script>

