<!-- Drunken Glass Branded Footer -->
<footer class="dg-footer">
  <div class="dg-foot-in">
    <div>
      <div class="brand streak">{{ section.settings.brand_name | default: 'Drunken Glass' }}</div>
      <p class="fmono" style="margin-top:10px">
        Made at our furnace <span class="dot">✦</span> sold direct
      </p>
      {%- if section.settings.tagline != blank -%}
        <p class="fmono" style="margin-top:8px;color:rgba(242,241,240,.5)">{{ section.settings.tagline }}</p>
      {%- endif -%}
    </div>

    <div class="fmono">
      {{ section.settings.about_text | default: 'Fifteen years of borosilicate<br>Hand-cut lead-free crystal<br>Wine · cocktail · whisky · coffee<br>Tumblers · decanters · candles' }}
    </div>

    <div class="fl2x">
      {%- if section.settings.link_list_1 != blank -%}
        {%- for link in linklists[section.settings.link_list_1].links -%}
          <a href="{{ link.url }}">{{ link.title }}</a><br>
        {%- endfor -%}
      {%- else -%}
        <a href="{{ routes.root_url }}pages/contact">Contact us</a><br>
        <a href="{{ routes.root_url }}pages/track-order">Track your order</a><br>
        <a href="{{ routes.root_url }}pages/shipping">Shipping policy</a><br>
        <a href="{{ routes.root_url }}pages/returns">Returns &amp; replacement</a>
      {%- endif -%}
    </div>

    <div class="fl2x">
      {%- if section.settings.link_list_2 != blank -%}
        {%- for link in linklists[section.settings.link_list_2].links -%}
          <a href="{{ link.url }}">{{ link.title }}</a><br>
        {%- endfor -%}
      {%- else -%}
        <a href="{{ routes.root_url }}pages/privacy">Privacy policy</a><br>
        <a href="{{ routes.root_url }}pages/terms">Terms &amp; conditions</a><br>
        <a href="{{ routes.root_url }}pages/gifting">Corporate gifting</a>
      {%- endif -%}
    </div>
  </div>

  <div class="dg-footer-copy">
    &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Made at our furnace. Sold direct.
  </div>
</footer>

{% schema %}
{
  "name": "Drunken Glass Footer",
  "class": "shopify-section-group-footer-section",
  "limit": 1,
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "Drunken Glass"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline under brand",
      "default": "Firozabad, India"
    },
    {
      "type": "html",
      "id": "about_text",
      "label": "About copy",
      "default": "Fifteen years of borosilicate<br>Hand-cut lead-free crystal<br>Wine · cocktail · whisky · coffee<br>Tumblers · decanters · candles"
    },
    {
      "type": "link_list",
      "id": "link_list_1",
      "label": "Links column 1 (customer service)"
    },
    {
      "type": "link_list",
      "id": "link_list_2",
      "label": "Links column 2 (policies)"
    }
  ]
}
{% endschema %}
