<section class="sec wrap" id="dg-quiz">
  <div class="quiz" id="quizBox">
    <div class="quiz-l">
      <h2 class="h2">{{ section.settings.heading | default: 'Which Glass Are You?' }}</h2>
      <p class="sub">{{ section.settings.subheading | default: '3 quick questions. One perfect glass. Zero commitment issues.' }}</p>
      
      <div class="quiz-progress" style="margin-top:20px;height:6px;background:var(--rule);border-radius:3px;overflow:hidden;max-width:320px">
        <div id="quizProgressBar" style="height:100%;width:33%;background:var(--blue);transition:width .25s ease"></div>
      </div>
    </div>

    <div class="quiz-r" id="quizContent">
      <!-- Step 1 -->
      <div class="quiz-step" data-step="1">
        <p class="quiz-q" style="font:700 20px var(--f-head);margin-bottom:16px">1. What’s in your glass at 4 PM?</p>
        <div class="quiz-opts" style="display:grid;gap:12px">
          <button class="quiz-opt btn" type="button" data-scores='{"cortado-glasses-set":3,"coffee-break-cup":2,"heart-eyes-mug":1}'>
            <span>A Chai Latte, Obviously</span>
            <small style="display:block;opacity:.7;font-weight:400">Extra cinnamon, extra gossip</small>
          </button>
          <button class="quiz-opt btn" type="button" data-scores='{"cherry-bomb":2,"the-wobble":2,"daisy-days":1}'>
            <span>Iced Coffee, Extra Ice</span>
            <small style="display:block;opacity:.7;font-weight:400">The oat milk is non-negotiable</small>
          </button>
          <button class="quiz-opt btn" type="button" data-scores='{"crush-coupe":2,"starstruck-coupe":2,"after-hours-rocks":1}'>
            <span>A Mocktail with a Tiny Umbrella</span>
            <small style="display:block;opacity:.7;font-weight:400">It’s 5 PM somewhere</small>
          </button>
          <button class="quiz-opt btn" type="button" data-scores='{"lemon-drop":3,"cloud-nine-mug":2}'>
            <span>Matcha, or Anything Green</span>
            <small style="display:block;opacity:.7;font-weight:400">Your gut health is thriving</small>
          </button>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="quiz-step" data-step="2" style="display:none">
        <p class="quiz-q" style="font:700 20px var(--f-head);margin-bottom:16px">2. Pick a Saturday plan</p>
        <div class="quiz-opts" style="display:grid;gap:12px">
          <button class="quiz-opt btn" type="button" data-scores='{"heart-eyes-mug":3,"cloud-nine-mug":2}'>
            <span>Farmer's Market & Fresh Flowers</span>
            <small style="display:block;opacity:.7;font-weight:400">Tote bag full of sourdough</small>
          </button>
          <button class="quiz-opt btn" type="button" data-scores='{"starstruck-coupe":3,"crush-coupe":2}'>
            <span>Dinner Party That Goes Till 2 AM</span>
            <small style="display:block;opacity:.7;font-weight:400">Candlelight and natural wine</small>
          </button>
          <button class="quiz-opt btn" type="button" data-scores='{"the-wobble":3,"cherry-bomb":2}'>
            <span>Browsing a Vintage Record Store</span>
            <small style="display:block;opacity:.7;font-weight:400">Dopamine dressing in full effect</small>
          </button>
          <button class="quiz-opt btn" type="button" data-scores='{"cortado-glasses-set":3,"coffee-break-cup":2}'>
            <span>Couch, Good Book, Phone on Do-Not-Disturb</span>
            <small style="display:block;opacity:.7;font-weight:400">Unreachable in the best way</small>
          </button>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="quiz-step" data-step="3" style="display:none">
        <p class="quiz-q" style="font:700 20px var(--f-head);margin-bottom:16px">3. Your aesthetic in one word</p>
        <div class="quiz-opts" style="display:grid;gap:12px">
          <button class="quiz-opt btn" type="button" data-scores='{"cherry-bomb":3,"daisy-days":2}'>
            <span>Playful & Nostalgic</span>
            <small style="display:block;opacity:.7;font-weight:400">Y2K bubbles & primary brights</small>
          </button>
          <button class="quiz-opt btn" type="button" data-scores='{"the-wobble":3,"lemon-drop":2}'>
            <span>Architectural & Wavy</span>
            <small style="display:block;opacity:.7;font-weight:400">Clean lines with an unexpected twist</small>
          </button>
          <button class="quiz-opt btn" type="button" data-scores='{"heart-eyes-mug":3,"cloud-nine-mug":2}'>
            <span>Soft Romantic</span>
            <small style="display:block;opacity:.7;font-weight:400">Pastels, curves and sweet treats</small>
          </button>
          <button class="quiz-opt btn" type="button" data-scores='{"starstruck-coupe":3,"after-hours-rocks":2}'>
            <span>Moody & Minimal</span>
            <small style="display:block;opacity:.7;font-weight:400">Smoked tones and high drama</small>
          </button>
        </div>
      </div>

      <!-- Result Card -->
      <div class="quiz-res" id="quizResultCard" style="display:none">
        <div class="pcard" style="background:#fff;border:2px solid var(--ink);border-radius:var(--r);box-shadow:var(--sh);padding:20px;text-align:center">
          <span class="badge b-lime" style="position:static;display:inline-block;margin-bottom:12px">Your Soulmate Glass</span>
          <img id="resImg" src="{{ 'r3-r3co240.webp' | asset_url }}" alt="Result Glass" width="200" height="240" style="margin:0 auto 16px;display:block;object-fit:contain">
          <h3 id="resTitle" style="font:700 24px var(--f-head);margin-bottom:6px">R3 Cocktail Coupe 280ml</h3>
          <p id="resSub" style="color:var(--muted);font-size:14px;margin-bottom:16px">Handcrafted Borosilicate Glassware by R3 Exports.</p>
          <div class="prow" style="justify-content:center;margin-bottom:20px">
            <span class="price" id="resPrice" style="font-size:24px">$38</span>
          </div>
          <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap">
            <a class="btn btn-blue" id="resLink" href="/products/r3-vintage-borosilicate-cocktail-coupe-280ml-r3co240">See Details</a>
            <button class="btn btn-lime" id="resRetake" type="button">Retake Quiz</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const box = document.getElementById('quizBox');
  if (!box) return;

  const bar = document.getElementById('quizProgressBar');
  const steps = box.querySelectorAll('.quiz-step');
  const resCard = document.getElementById('quizResultCard');
  const resImg = document.getElementById('resImg');
  const resTitle = document.getElementById('resTitle');
  const resSub = document.getElementById('resSub');
  const resPrice = document.getElementById('resPrice');
  const resLink = document.getElementById('resLink');
  const resRetake = document.getElementById('resRetake');

  let currentStep = 1;
  const scores = {};

  const productData = {
    'cherry-bomb': { title: 'R3 Cocktail Coupe 280ml', price: '$38', sub: 'Handcrafted Borosilicate Glassware by R3 Exports.', img: '{{ "r3-r3co240.webp" | asset_url }}', url: '/products/r3-vintage-borosilicate-cocktail-coupe-280ml-r3co240' },
    'the-wobble': { title: 'R3 Fluted Tumbler 380ml', price: '$32', sub: '100% Thermal Shock Resistant Borosilicate Glass.', img: '{{ "r3-r3tu113.webp" | asset_url }}', url: '/products/r3-fluted-borosilicate-tumbler-glass-380ml-r3tu113' },
    'heart-eyes-mug': { title: 'R3 Classic Coffee Mug 350ml', price: '$28', sub: 'Safe for boiling espresso and chai latte.', img: '{{ "r3-r3tc117.webp" | asset_url }}', url: '/products/r3-classic-borosilicate-coffee-mug-350ml-r3tc117' },
    'starstruck-coupe': { title: 'R3 Stemmed Wine Glass 360ml', price: '$38', sub: 'Ultra-fine stem with balloon bowl.', img: '{{ "r3-r3wg237.webp" | asset_url }}', url: '/products/r3-stemmed-borosilicate-wine-glass-360ml-r3wg237' },
    'cortado-glasses-set': { title: 'R3 Double Wall Glass 270ml', price: '$34', sub: 'Thermal insulated, cool to touch exterior.', img: '{{ "r3-r3dg107.webp" | asset_url }}', url: '/products/r3-insulated-double-wall-borosilicate-glass-270ml-r3dg107' },
    'lemon-drop': { title: 'R3 Highball Tumbler 420ml', price: '$26', sub: 'High clarity everyday borosilicate tumbler.', img: '{{ "r3-r3tu128.webp" | asset_url }}', url: '/products/r3-highball-borosilicate-tumbler-glass-420ml-r3tu128' }
  };

  box.querySelectorAll('.quiz-opt').forEach(function(btn) {
    btn.addEventListener('click', function() {
      const stepScores = JSON.parse(btn.dataset.scores || '{}');
      for (const [handle, pts] of Object.entries(stepScores)) {
        scores[handle] = (scores[handle] || 0) + pts;
      }

      currentStep++;
      if (currentStep <= 3) {
        steps.forEach(s => s.style.display = (s.dataset.step == currentStep) ? 'block' : 'none');
        bar.style.width = (currentStep === 2 ? '66%' : '100%');
      } else {
        // Show result
        steps.forEach(s => s.style.display = 'none');
        bar.style.width = '100%';
        resCard.style.display = 'block';

        let topHandle = 'cherry-bomb';
        let topScore = -1;
        for (const [handle, score] of Object.entries(scores)) {
          if (score > topScore && productData[handle]) {
            topScore = score;
            topHandle = handle;
          }
        }

        const win = productData[topHandle];
        resImg.src = win.img;
        resTitle.textContent = win.title;
        resSub.textContent = win.sub;
        resPrice.textContent = win.price;
        resLink.href = win.url;
      }
    });
  });

  if (resRetake) {
    resRetake.addEventListener('click', function() {
      currentStep = 1;
      for (const k of Object.keys(scores)) delete scores[k];
      resCard.style.display = 'none';
      steps.forEach(s => s.style.display = (s.dataset.step == 1) ? 'block' : 'none');
      bar.style.width = '33%';
    });
  }
});
</script>

{% schema %}
{
  "name": "DG Glassware Quiz",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Which Glass Are You?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "3 quick questions. One perfect glass. Zero commitment issues."
    }
  ],
  "presets": [
    {
      "name": "DG Glassware Quiz"
    }
  ]
}
{% endschema %}
