<section class="sec" style="background:var(--cloud);border-block:2px solid var(--ink)" id="dg-story-rows">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <h2 class="h2">{{ section.settings.heading | default: 'from furnace to your shelf' }}</h2>
        <p class="sub">{{ section.settings.subheading | default: 'how a drunken glass gets made. no shortcuts, no thin fragile glass.' }}</p>
      </div>
      <a class="link" href="/pages/our-story">read full story</a>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:24px;margin-top:24px">
      <!-- Step 1 -->
      <div style="background:#fff;border:2px solid var(--ink);border-radius:var(--r);box-shadow:var(--sh);padding:24px">
        <span class="mono" style="font-size:32px;font-weight:700;color:var(--berry);display:block;margin-bottom:8px">01</span>
        <h3 style="font:700 18px var(--f-head);margin-bottom:6px">melt</h3>
        <p style="color:var(--muted);font-size:15px">sand and boron go into our furnace at around 2,900°F (1,600°C) until molten clear.</p>
      </div>

      <!-- Step 2 -->
      <div style="background:#fff;border:2px solid var(--ink);border-radius:var(--r);box-shadow:var(--sh);padding:24px">
        <span class="mono" style="font-size:32px;font-weight:700;color:var(--blue);display:block;margin-bottom:8px">02</span>
        <h3 style="font:700 18px var(--f-head);margin-bottom:6px">shape</h3>
        <p style="color:var(--muted);font-size:15px">molten glass becomes strawberries, hearts, waves and whatever we dream up next.</p>
      </div>

      <!-- Step 3 -->
      <div style="background:#fff;border:2px solid var(--ink);border-radius:var(--r);box-shadow:var(--sh);padding:24px">
        <span class="mono" style="font-size:32px;font-weight:700;color:var(--ink);display:block;margin-bottom:8px">03</span>
        <h3 style="font:700 18px var(--f-head);margin-bottom:6px">anneal</h3>
        <p style="color:var(--muted);font-size:15px">each piece cools slowly at around 1,040°F (560°C) in the lehr so it doesn’t crack on heat.</p>
      </div>

      <!-- Step 4 -->
      <div style="background:#fff;border:2px solid var(--ink);border-radius:var(--r);box-shadow:var(--sh);padding:24px">
        <span class="mono" style="font-size:32px;font-weight:700;color:var(--berry);display:block;margin-bottom:8px">04</span>
        <h3 style="font:700 18px var(--f-head);margin-bottom:6px">finish</h3>
        <p style="color:var(--muted);font-size:15px">colors, ceramic decals, and rims get their final hand-fired polish.</p>
      </div>

      <!-- Step 5 -->
      <div style="background:#fff;border:2px solid var(--ink);border-radius:var(--r);box-shadow:var(--sh);padding:24px">
        <span class="mono" style="font-size:32px;font-weight:700;color:var(--blue);display:block;margin-bottom:8px">05</span>
        <h3 style="font:700 18px var(--f-head);margin-bottom:6px">check</h3>
        <p style="color:var(--muted);font-size:15px">we inspect every single glass for chips, cracks, and wonky bubble bits.</p>
      </div>

      <!-- Step 6 -->
      <div style="background:#fff;border:2px solid var(--ink);border-radius:var(--r);box-shadow:var(--sh);padding:24px">
        <span class="mono" style="font-size:32px;font-weight:700;color:var(--ink);display:block;margin-bottom:8px">06</span>
        <h3 style="font:700 18px var(--f-head);margin-bottom:6px">pack</h3>
        <p style="color:var(--muted);font-size:15px">packed like it’s headed to a museum with 100% plastic-free cushioned packaging.</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "DG Story Rows",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "from furnace to your shelf"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "how a drunken glass gets made. no shortcuts, no thin fragile glass."
    }
  ],
  "presets": [
    {
      "name": "DG Story Rows"
    }
  ]
}
{% endschema %}
