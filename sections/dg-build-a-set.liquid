<section class="wrap sec" id="dg-build-a-set" style="padding-top:16px">
  <!-- Page Header -->
  <header class="page-head" style="margin-bottom:28px">
    <span class="badge b-pink" style="display:inline-block;margin-bottom:8px">bundle offer</span>
    <h1 class="h2">build a set: any 4 for $99</h1>
    <p class="sub">pick your four favorites from the grid below. we’ll bundle them in our signature gift box and knock up to $45 off at checkout.</p>
  </header>

  <div style="display:grid;grid-template-columns:1fr 340px;gap:32px;align-items:start" class="build-grid-wrap">
    <!-- Left: Product Selection Grid -->
    <div class="grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:20px">
      <!-- Item 1: Cherry Bomb -->
      <article class="pcard bset-card" data-handle="cherry-bomb" data-title="cherry bomb tumbler" data-img="{{ 'cherry-bomb--blush.png' | asset_url }}" data-price="36">
        <div class="pmedia" style="--bg:#ffe1e8">
          <span class="count-badge" style="display:none;position:absolute;top:10px;right:10px;background:var(--ink);color:#fff;border-radius:50%;width:26px;height:26px;font:700 12px var(--f-mono);display:none;align-items:center;justify-content:center">0</span>
          <img src="{{ 'cherry-bomb--blush.png' | asset_url }}" alt="cherry bomb" width="180" height="220" loading="lazy">
        </div>
        <div class="pinfo">
          <b class="pname" style="font-size:15px">cherry bomb tumbler</b>
          <span class="price">$36</span>
          <button class="btn btn-lime sm bset-add-btn" type="button" style="margin-top:10px;width:100%">+ add to set</button>
        </div>
      </article>

      <!-- Item 2: The Wobble -->
      <article class="pcard bset-card" data-handle="the-wobble" data-title="the wobble tumbler" data-img="{{ 'the-wobble--electric-blue.png' | asset_url }}" data-price="36">
        <div class="pmedia" style="--bg:#dfe8ff">
          <span class="count-badge" style="display:none;position:absolute;top:10px;right:10px;background:var(--ink);color:#fff;border-radius:50%;width:26px;height:26px;font:700 12px var(--f-mono);display:none;align-items:center;justify-content:center">0</span>
          <img src="{{ 'the-wobble--electric-blue.png' | asset_url }}" alt="the wobble" width="180" height="220" loading="lazy">
        </div>
        <div class="pinfo">
          <b class="pname" style="font-size:15px">the wobble tumbler</b>
          <span class="price">$36</span>
          <button class="btn btn-lime sm bset-add-btn" type="button" style="margin-top:10px;width:100%">+ add to set</button>
        </div>
      </article>

      <!-- Item 3: Heart Eyes Mug -->
      <article class="pcard bset-card" data-handle="heart-eyes-mug" data-title="heart eyes mug" data-img="{{ 'heart-eyes-mug--berry-crush.png' | asset_url }}" data-price="34">
        <div class="pmedia" style="--bg:#ffe1e8">
          <span class="count-badge" style="display:none;position:absolute;top:10px;right:10px;background:var(--ink);color:#fff;border-radius:50%;width:26px;height:26px;font:700 12px var(--f-mono);display:none;align-items:center;justify-content:center">0</span>
          <img src="{{ 'heart-eyes-mug--berry-crush.png' | asset_url }}" alt="heart eyes mug" width="180" height="220" loading="lazy">
        </div>
        <div class="pinfo">
          <b class="pname" style="font-size:15px">heart eyes mug</b>
          <span class="price">$34</span>
          <button class="btn btn-lime sm bset-add-btn" type="button" style="margin-top:10px;width:100%">+ add to set</button>
        </div>
      </article>

      <!-- Item 4: Lemon Drop -->
      <article class="pcard bset-card" data-handle="lemon-drop" data-title="lemon drop tumbler" data-img="{{ 'lemon-drop--sunny.png' | asset_url }}" data-price="34">
        <div class="pmedia" style="--bg:#f8fac4">
          <span class="count-badge" style="display:none;position:absolute;top:10px;right:10px;background:var(--ink);color:#fff;border-radius:50%;width:26px;height:26px;font:700 12px var(--f-mono);display:none;align-items:center;justify-content:center">0</span>
          <img src="{{ 'lemon-drop--sunny.png' | asset_url }}" alt="lemon drop" width="180" height="220" loading="lazy">
        </div>
        <div class="pinfo">
          <b class="pname" style="font-size:15px">lemon drop tumbler</b>
          <span class="price">$34</span>
          <button class="btn btn-lime sm bset-add-btn" type="button" style="margin-top:10px;width:100%">+ add to set</button>
        </div>
      </article>

      <!-- Item 5: Blue Moon Coupe -->
      <article class="pcard bset-card" data-handle="blue-moon-coupe" data-title="blue moon coupe" data-img="{{ 'blue-moon-coupe--blue-moon.png' | asset_url }}" data-price="38">
        <div class="pmedia" style="--bg:#dfe8ff">
          <span class="count-badge" style="display:none;position:absolute;top:10px;right:10px;background:var(--ink);color:#fff;border-radius:50%;width:26px;height:26px;font:700 12px var(--f-mono);display:none;align-items:center;justify-content:center">0</span>
          <img src="{{ 'blue-moon-coupe--blue-moon.png' | asset_url }}" alt="blue moon coupe" width="180" height="220" loading="lazy">
        </div>
        <div class="pinfo">
          <b class="pname" style="font-size:15px">blue moon coupe</b>
          <span class="price">$38</span>
          <button class="btn btn-lime sm bset-add-btn" type="button" style="margin-top:10px;width:100%">+ add to set</button>
        </div>
      </article>

      <!-- Item 6: Cloud Nine Mug -->
      <article class="pcard bset-card" data-handle="cloud-nine-mug" data-title="cloud nine mug" data-img="{{ 'cloud-nine-mug--sky.png' | asset_url }}" data-price="32">
        <div class="pmedia" style="--bg:#dfe8ff">
          <span class="count-badge" style="display:none;position:absolute;top:10px;right:10px;background:var(--ink);color:#fff;border-radius:50%;width:26px;height:26px;font:700 12px var(--f-mono);display:none;align-items:center;justify-content:center">0</span>
          <img src="{{ 'cloud-nine-mug--sky.png' | asset_url }}" alt="cloud nine mug" width="180" height="220" loading="lazy">
        </div>
        <div class="pinfo">
          <b class="pname" style="font-size:15px">cloud nine mug</b>
          <span class="price">$32</span>
          <button class="btn btn-lime sm bset-add-btn" type="button" style="margin-top:10px;width:100%">+ add to set</button>
        </div>
      </article>
    </div>

    <!-- Right: Sticky 4-Slot Tray -->
    <div class="tray" style="position:sticky;top:90px;background:#fff;border:2px solid var(--ink);border-radius:var(--r);box-shadow:var(--sh);padding:20px">
      <h3 style="font:700 18px var(--f-head);margin-bottom:12px">your 4-glass set</h3>
      
      <!-- 4 Slot Grid -->
      <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:20px">
        <div class="slot" id="slot-0" style="aspect-ratio:1;border:2px dashed var(--ink);border-radius:var(--r);display:flex;align-items:center;justify-content:center;position:relative;background:var(--cloud)">
          <span style="font-size:24px;color:var(--muted)">+</span>
        </div>
        <div class="slot" id="slot-1" style="aspect-ratio:1;border:2px dashed var(--ink);border-radius:var(--r);display:flex;align-items:center;justify-content:center;position:relative;background:var(--cloud)">
          <span style="font-size:24px;color:var(--muted)">+</span>
        </div>
        <div class="slot" id="slot-2" style="aspect-ratio:1;border:2px dashed var(--ink);border-radius:var(--r);display:flex;align-items:center;justify-content:center;position:relative;background:var(--cloud)">
          <span style="font-size:24px;color:var(--muted)">+</span>
        </div>
        <div class="slot" id="slot-3" style="aspect-ratio:1;border:2px dashed var(--ink);border-radius:var(--r);display:flex;align-items:center;justify-content:center;position:relative;background:var(--cloud)">
          <span style="font-size:24px;color:var(--muted)">+</span>
        </div>
      </div>

      <!-- Pricing Summary -->
      <div style="border-top:2px solid var(--ink);padding-top:16px;margin-bottom:16px">
        <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:6px">
          <span style="font-size:14px;color:var(--muted)">original total:</span>
          <s class="mono" id="bsetOriginalPrice" style="color:var(--muted);font-size:15px">$0</s>
        </div>
        <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:8px">
          <span style="font:700 16px var(--f-head)">bundle price:</span>
          <span class="price" id="bsetFinalPrice" style="font-size:24px;font-weight:700">$99</span>
        </div>
        <div id="bsetSaveBadge" class="badge b-pink" style="display:none;position:static;font-size:12px;margin-bottom:12px">you save $45</div>
        <p id="bsetStatusText" style="font-size:13px;color:var(--muted)">pick 4 glasses to unlock the $99 price</p>
      </div>

      <button class="btn btn-blue full" id="bsetSubmitBtn" type="button" disabled style="min-height:50px">add set to bag</button>
    </div>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const slots = [
    document.getElementById('slot-0'),
    document.getElementById('slot-1'),
    document.getElementById('slot-2'),
    document.getElementById('slot-3')
  ];
  const origPriceEl = document.getElementById('bsetOriginalPrice');
  const saveBadge = document.getElementById('bsetSaveBadge');
  const statusText = document.getElementById('bsetStatusText');
  const submitBtn = document.getElementById('bsetSubmitBtn');
  const addedDrawer = document.getElementById('dgAddedDrawer');
  const scrim = document.getElementById('dgScrim');

  let selectedItems = [];

  function updateTray() {
    let sum = 0;
    const counts = {};

    slots.forEach((slot, idx) => {
      if (selectedItems[idx]) {
        const item = selectedItems[idx];
        sum += item.price;
        counts[item.handle] = (counts[item.handle] || 0) + 1;

        slot.innerHTML = `
          <img src="${item.img}" alt="${item.title}" width="60" height="70" style="object-fit:contain">
          <button type="button" class="remove-slot" data-idx="${idx}" style="position:absolute;top:4px;right:4px;background:var(--ink);color:#fff;border-radius:50%;width:20px;height:20px;border:0;display:flex;align-items:center;justify-content:center;font-size:12px;cursor:pointer">✕</button>
        `;
        slot.style.borderStyle = 'solid';
        slot.style.background = '#fff';
      } else {
        slot.innerHTML = '<span style="font-size:24px;color:var(--muted)">+</span>';
        slot.style.borderStyle = 'dashed';
        slot.style.background = 'var(--cloud)';
      }
    });

    // Update count badges on cards
    document.querySelectorAll('.bset-card').forEach(card => {
      const h = card.dataset.handle;
      const badge = card.querySelector('.count-badge');
      const count = counts[h] || 0;
      if (count > 0) {
        badge.style.display = 'flex';
        badge.textContent = count;
      } else {
        badge.style.display = 'none';
      }
    });

    origPriceEl.textContent = '$' + sum;

    if (selectedItems.length === 4) {
      const saving = Math.max(0, sum - 99);
      saveBadge.style.display = 'inline-block';
      saveBadge.textContent = 'you save $' + saving;
      statusText.textContent = 'set complete! signature gift box included.';
      submitBtn.disabled = false;
    } else {
      saveBadge.style.display = 'none';
      statusText.textContent = `pick ${4 - selectedItems.length} more glass${4 - selectedItems.length === 1 ? '' : 'es'} to unlock $99`;
      submitBtn.disabled = true;
    }
  }

  // Add click on cards
  document.querySelectorAll('.bset-add-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      if (selectedItems.length >= 4) {
        alert('Your 4-glass set is full! Remove a glass from the tray to replace it.');
        return;
      }
      const card = btn.closest('.bset-card');
      selectedItems.push({
        handle: card.dataset.handle,
        title: card.dataset.title,
        img: card.dataset.img,
        price: parseFloat(card.dataset.price)
      });
      updateTray();
    });
  });

  // Remove slot click
  document.addEventListener('click', function(e) {
    if (e.target && e.target.classList.contains('remove-slot')) {
      const idx = parseInt(e.target.dataset.idx);
      selectedItems.splice(idx, 1);
      updateTray();
    }
  });

  if (submitBtn) {
    submitBtn.addEventListener('click', function() {
      if (addedDrawer) addedDrawer.classList.add('open');
      if (scrim) scrim.classList.add('open');
    });
  }
});
</script>

