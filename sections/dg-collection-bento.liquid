<section class="sec wrap" id="dg-collection-bento">
  <div class="sec-head">
    <div>
      <h2 class="h2">{{ section.settings.heading | default: 'Pick Your Era' }}</h2>
      <p class="sub">{{ section.settings.subheading | default: 'Seven collections, one golden rule: No boring glasses.' }}</p>
    </div>
  </div>

  <div class="bento">
    <!-- Tile 1: Fruit Club (Big) -->
    <a class="era big" href="/collections/tumblers" style="--bg:#ef426f;--fg:#ffffff">
      <div>
        <b>Tumbler Glasses</b>
        <p>Fluted, highball, and cold brew borosilicate tumblers.</p>
      </div>
      <span class="count">4 Designs</span>
      <div class="art">
        <img src="{{ 'r3-r3tu113.webp' | asset_url }}" alt="Tumblers" width="160" height="200" loading="lazy" style="object-fit:contain">
      </div>
    </a>

    <!-- Tile 2: Heart Eyes -->
    <a class="era" href="/collections/mugs" style="--bg:#ffe1e8;--fg:#0a0a0a">
      <div>
        <b>Mugs & Cups</b>
        <p>Thermal shock resistant for boiling coffee & tea.</p>
      </div>
      <span class="count">8 Designs</span>
      <div class="art">
        <img src="{{ 'r3-r3tc117.webp' | asset_url }}" alt="Mugs" width="130" height="160" loading="lazy" style="object-fit:contain">
      </div>
    </a>

    <!-- Tile 3: Golden Hour -->
    <a class="era" href="/collections/double-glass" style="--bg:#eaef29;--fg:#0a0a0a">
      <div>
        <b>Double Wall</b>
        <p>Insulated borosilicate keeps heat in and hands cool.</p>
      </div>
      <span class="count">4 Designs</span>
      <div class="art">
        <img src="{{ 'r3-r3dg107.webp' | asset_url }}" alt="Double Wall" width="130" height="160" loading="lazy" style="object-fit:contain">
      </div>
    </a>

    <!-- Tile 4: The Wobble (Wide) -->
    <a class="era wide" href="/collections/cocktail-glasses" style="--bg:#2765fa;--fg:#ffffff">
      <div>
        <b>Cocktail Coupes</b>
        <p>Wide rims, vintage cuts, and cocktail bar grade clarity.</p>
      </div>
      <span class="count">8 Designs</span>
      <div class="art">
        <img src="{{ 'r3-r3co240.webp' | asset_url }}" alt="Cocktail Coupes" width="160" height="200" loading="lazy" style="object-fit:contain">
      </div>
    </a>

    <!-- Tile 5: Café Club -->
    <a class="era" href="/collections/espresso-tea" style="--bg:#f2f1f0;--fg:#0a0a0a">
      <div>
        <b>Espresso & Tea</b>
        <p>Cortados, cappuccinos and slow morning sips.</p>
      </div>
      <span class="count">8 Designs</span>
      <div class="art">
        <img src="{{ 'r3-r3tc127.webp' | asset_url }}" alt="Espresso & Tea" width="130" height="160" loading="lazy" style="object-fit:contain">
      </div>
    </a>

    <!-- Tile 6: After Hours -->
    <a class="era" href="/collections/wine-glasses" style="--bg:#0a0a0a;--fg:#ffffff">
      <div>
        <b>Wine Glasses</b>
        <p>Ultra-fine stems and balloon bowls for evening wine.</p>
      </div>
      <span class="count">4 Designs</span>
      <div class="art">
        <img src="{{ 'r3-r3wg237.webp' | asset_url }}" alt="Wine Glasses" width="130" height="160" loading="lazy" style="object-fit:contain">
      </div>
    </a>

    <!-- Tile 7: Y2K Bloom -->
    <a class="era" href="/collections/all" style="--bg:#dfe8ff;--fg:#0a0a0a">
      <div>
        <b>Highball Glasses</b>
        <p>Crystal clear 420ml glasses handcrafted in Agra furnace.</p>
      </div>
      <span class="count">4 Designs</span>
      <div class="art">
        <img src="{{ 'r3-r3tu128.webp' | asset_url }}" alt="Highball Glasses" width="130" height="160" loading="lazy" style="object-fit:contain">
      </div>
    </a>

    <!-- Quiz CTA Tile -->
    <a class="era" href="/pages/quiz" style="--bg:#ffffff;--fg:#0a0a0a;border-style:dashed">
      <div>
        <b>Can’t Decide?</b>
        <p>Take the 30-second quiz and we’ll pick for you.</p>
      </div>
      <span class="count">3 Questions</span>
      <div class="art" style="font:400 42px var(--f-display);color:var(--berry);display:flex;align-items:center;justify-content:center">
        ?
      </div>
    </a>
  </div>
</section>

{% schema %}
{
  "name": "DG Collection Bento",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pick Your Era"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Seven collections, one golden rule: No boring glasses."
    }
  ],
  "presets": [
    {
      "name": "DG Collection Bento"
    }
  ]
}
{% endschema %}
