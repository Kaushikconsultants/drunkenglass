<section class="sec wrap" id="dg-collection-bento">
  <div class="sec-head">
    <div>
      <h2 class="h2">{{ section.settings.heading | default: 'Pick Your Era' }}</h2>
      <p class="sub">{{ section.settings.subheading | default: 'Seven collections, one golden rule: No boring glasses.' }}</p>
    </div>
  </div>

  <div class="bento">
    <!-- Tile 1: Fruit Club (Big) -->
    <a class="era big" href="/collections/fruit-club" style="--bg:#ef426f;--fg:#ffffff">
      <div>
        <b>Fruit Club</b>
        <p>Strawberries, cherries, lemons. Your 5-a-day, sorted.</p>
      </div>
      <span class="count">4 Designs</span>
      <div class="art">
        <img src="{{ 'cherry-bomb--blush.png' | asset_url }}" alt="Fruit Club" width="160" height="200" loading="lazy">
      </div>
    </a>

    <!-- Tile 2: Heart Eyes -->
    <a class="era" href="/collections/heart-eyes" style="--bg:#ffe1e8;--fg:#0a0a0a">
      <div>
        <b>Heart Eyes</b>
        <p>For hopeless romantics & situationship survivors.</p>
      </div>
      <span class="count">3 Designs</span>
      <div class="art">
        <img src="{{ 'heart-eyes-mug--berry-crush.png' | asset_url }}" alt="Heart Eyes" width="130" height="160" loading="lazy">
      </div>
    </a>

    <!-- Tile 3: Golden Hour -->
    <a class="era" href="/collections/golden-hour" style="--bg:#eaef29;--fg:#0a0a0a">
      <div>
        <b>Golden Hour</b>
        <p>Gradients that look like 6:47pm feels.</p>
      </div>
      <span class="count">3 Designs</span>
      <div class="art">
        <img src="{{ 'lemon-drop--sunny.png' | asset_url }}" alt="Golden Hour" width="130" height="160" loading="lazy">
      </div>
    </a>

    <!-- Tile 4: The Wobble (Wide) -->
    <a class="era wide" href="/collections/the-wobble" style="--bg:#2765fa;--fg:#ffffff">
      <div>
        <b>The Wobble</b>
        <p>Wavy lines, zero straight edges. Built to fidget with.</p>
      </div>
      <span class="count">4 Designs</span>
      <div class="art">
        <img src="{{ 'the-wobble--electric-blue.png' | asset_url }}" alt="The Wobble" width="160" height="200" loading="lazy">
      </div>
    </a>

    <!-- Tile 5: Café Club -->
    <a class="era" href="/collections/cafe-club" style="--bg:#f2f1f0;--fg:#0a0a0a">
      <div>
        <b>Café Club</b>
        <p>Cortados, cappuccinos and slow Sunday mornings.</p>
      </div>
      <span class="count">3 Designs</span>
      <div class="art">
        <img src="{{ 'coffee-break-cup--berry-polka.png' | asset_url }}" alt="Café Club" width="130" height="160" loading="lazy">
      </div>
    </a>

    <!-- Tile 6: After Hours -->
    <a class="era" href="/collections/after-hours" style="--bg:#0a0a0a;--fg:#ffffff">
      <div>
        <b>After Hours</b>
        <p>Smoked glass & midnight coupes for drinks after dark.</p>
      </div>
      <span class="count">3 Designs</span>
      <div class="art">
        <img src="{{ 'starstruck-coupe--deep-blue.png' | asset_url }}" alt="After Hours" width="130" height="160" loading="lazy">
      </div>
    </a>

    <!-- Tile 7: Y2K Bloom -->
    <a class="era" href="/collections/y2k-bloom" style="--bg:#dfe8ff;--fg:#0a0a0a">
      <div>
        <b>Y2K Bloom</b>
        <p>Daisies and bubble shapes straight off your 2004 Tumblr.</p>
      </div>
      <span class="count">3 Designs</span>
      <div class="art">
        <img src="{{ 'daisy-days--blue-daisy.png' | asset_url }}" alt="Y2K Bloom" width="130" height="160" loading="lazy">
      </div>
    </a>

    <!-- Quiz CTA Tile -->
    <a class="era" href="/pages/quiz" style="--bg:#ffffff;--fg:#0a0a0a;border-style:dashed">
      <div>
        <b>Can’t Decide?</b>
        <p>Take the 30-second quiz and we’ll pick for you.</p>
      </div>
      <span class="count">3 Questions</span>
      <div class="art" style="font:400 42px var(--f-display);color:var(--berry);display:flex;align-items:center;justify-content:center">
        ?
      </div>
    </a>
  </div>
</section>

{% schema %}
{
  "name": "DG Collection Bento",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pick Your Era"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Seven collections, one golden rule: No boring glasses."
    }
  ],
  "presets": [
    {
      "name": "DG Collection Bento"
    }
  ]
}
{% endschema %}
