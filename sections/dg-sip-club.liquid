<section class="sec wrap" id="dg-sip-club">
  <div style="background:#ef426f;border:2px solid var(--ink);border-radius:var(--r);box-shadow:var(--sh);padding:clamp(28px,6vw,56px);color:#fff;text-align:center;max-width:880px;margin:0 auto">
    <span class="badge b-lime" style="position:static;display:inline-block;margin-bottom:12px;color:#0a0a0a">first sip's on us</span>
    <h2 class="h2" style="color:#fff;margin-bottom:12px">{{ section.settings.heading | default: 'welcome to the sip club' }}</h2>
    <p style="font-size:16px;max-width:540px;margin:0 auto 24px;opacity:.95">{{ section.settings.subheading | default: '10% off your first order, plus drop alerts before we post to instagram. no spam, we hate it too.' }}</p>

    <!-- Email Capture Form -->
    <form id="dgClubForm" style="display:flex;gap:8px;max-width:480px;margin:0 auto;flex-wrap:wrap;justify-content:center">
      <input type="email" id="dgClubEmail" placeholder="your email address" required style="flex:1;min-width:240px;min-height:50px;padding:0 16px;border:2px solid var(--ink);border-radius:var(--r);background:#fff;color:var(--ink);font:500 15px var(--f-body)">
      <button class="btn btn-lime" type="submit" style="min-height:50px">get 10% off</button>
    </form>

    <!-- Success Code Reveal -->
    <div id="dgClubSuccess" style="display:none;margin-top:20px;background:#fff;border:2px solid var(--ink);border-radius:var(--r);padding:16px;color:var(--ink);max-width:380px;margin-left:auto;margin-right:auto">
      <p style="font-weight:700;margin-bottom:8px">🎉 you’re on the list! use code at checkout:</p>
      <div style="display:flex;align-items:center;justify-content:center;gap:12px">
        <code class="mono" style="font-size:22px;font-weight:700;color:var(--berry);letter-spacing:1px">SIPSIP10</code>
        <button class="btn btn-blue sm" type="button" id="dgCopyCode">copy code</button>
      </div>
    </div>

    <p style="font-size:12px;opacity:.75;margin-top:16px">by signing up you agree to receive email marketing from drunken glass. unsubscribe anytime.</p>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const form = document.getElementById('dgClubForm');
  const success = document.getElementById('dgClubSuccess');
  const copyBtn = document.getElementById('dgCopyCode');

  if (form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      const email = document.getElementById('dgClubEmail').value;
      if (email) {
        form.style.display = 'none';
        success.style.display = 'block';
      }
    });
  }

  if (copyBtn) {
    copyBtn.addEventListener('click', function() {
      navigator.clipboard.writeText('SIPSIP10').then(function() {
        copyBtn.textContent = 'copied!';
        setTimeout(function() { copyBtn.textContent = 'copy code'; }, 2000);
      });
    });
  }
});
</script>

{% schema %}
{
  "name": "DG Sip Club",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "welcome to the sip club"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "10% off your first order, plus drop alerts before we post to instagram. no spam, we hate it too."
    }
  ],
  "presets": [
    {
      "name": "DG Sip Club"
    }
  ]
}
{% endschema %}
