<style>
  .custom-badgeband { background: var(--white); border-block: 2px solid var(--ink); }
  .badges { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; padding: 26px 0; max-width: 1240px; margin: 0 auto; padding-inline: var(--gutter); }
  .badge { display: flex; align-items: center; gap: 9px; border: 2px solid var(--ink); border-radius: 3px; background: var(--white); padding: 10px 14px; }
  .badge svg { width: 22px; height: 22px; stroke: var(--ink); fill: none; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; flex: 0 0 auto; }
  .badge span { font-family: 'Space Grotesk', sans-serif; font-size: .66rem; font-weight: 700; letter-spacing: .03em; text-transform: uppercase; white-space: nowrap; }
  .badge.hot { border-color: var(--blue); }
  .badge.hot svg { stroke: var(--blue); }
  .badge.hot span { color: var(--blue); }
</style>

<div class="custom-badgeband">
  <div class="wrap badges">
    {%- for block in section.blocks -%}
      <div class="badge {% if block.settings.is_hot %}hot{% endif %}">
        {{ block.settings.svg_icon }}
        <span>{{ block.settings.text }}</span>
      </div>
    {%- endfor -%}
  </div>
</div>

