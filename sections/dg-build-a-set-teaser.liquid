<section class="sec wrap" id="dg-build-a-set-teaser">
  <div class="set-banner" style="background:#eaef29;border:2px solid var(--ink);border-radius:var(--r);box-shadow:var(--sh);padding:clamp(24px,5vw,48px);display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:32px;align-items:center">
    <div>
      <span class="badge b-pink" style="margin-bottom:12px;display:inline-block">Bundle & Save</span>
      <h2 class="h2" style="margin-bottom:12px">{{ section.settings.heading | default: 'Build A Set: Any 4 For $99' }}</h2>
      <p class="sub" style="color:var(--ink);margin-bottom:24px">{{ section.settings.subheading | default: 'Mix and match your four favorite glasses and save up to $45. We’ll pack them together in our signature gift box.' }}</p>
      <a class="btn btn-ink" href="/pages/build-a-set">Start Building Your Set</a>
    </div>

    <!-- 4 Slot Visual Preview -->
    <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:12px">
      <div style="background:#fff;border:2px dashed var(--ink);border-radius:var(--r);aspect-ratio:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:12px;text-align:center">
        <img src="{{ 'r3-r3co240.webp' | asset_url }}" alt="Glass 1" width="70" height="90" style="margin-bottom:6px;object-fit:contain">
        <span class="mono" style="font-size:12px;font-weight:700">Coupe</span>
      </div>
      <div style="background:#fff;border:2px dashed var(--ink);border-radius:var(--r);aspect-ratio:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:12px;text-align:center">
        <img src="{{ 'r3-r3tu113.webp' | asset_url }}" alt="Glass 2" width="70" height="90" style="margin-bottom:6px;object-fit:contain">
        <span class="mono" style="font-size:12px;font-weight:700">Tumbler</span>
      </div>
      <div style="background:#fff;border:2px dashed var(--ink);border-radius:var(--r);aspect-ratio:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:12px;text-align:center">
        <img src="{{ 'r3-r3tc117.webp' | asset_url }}" alt="Glass 3" width="70" height="90" style="margin-bottom:6px;object-fit:contain">
        <span class="mono" style="font-size:12px;font-weight:700">Mug</span>
      </div>
      <div style="background:#fff;border:2px dashed var(--ink);border-radius:var(--r);aspect-ratio:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:12px;text-align:center">
        <span style="font:400 32px var(--f-display);color:var(--blue)">+</span>
        <span class="mono" style="font-size:12px;font-weight:700">Glass 4</span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "DG Build A Set Teaser",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build A Set: Any 4 For $99"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Mix and match your four favorite glasses and save up to $45. We’ll pack them together in our signature gift box."
    }
  ],
  "presets": [
    {
      "name": "DG Build A Set Teaser"
    }
  ]
}
{% endschema %}
