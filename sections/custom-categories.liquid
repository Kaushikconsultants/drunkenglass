<style>
  .custom-cats-section { padding-block: clamp(52px, 7vw, 92px); }
  .custom-cats-section .head { max-width: 60ch; margin-bottom: 40px; }
  .custom-cats-section .head p.kick { font-family: 'Space Grotesk', sans-serif; font-size: .68rem; letter-spacing: .18em; text-transform: uppercase; font-weight: 500; color: var(--blue); }
  .custom-cats-section .head h2 { font-weight: 700; font-size: clamp(2rem, 5.5vw, 3.4rem); line-height: 1; letter-spacing: -.02em; text-transform: uppercase; margin: 10px 0 12px; font-family: 'Space Grotesk', sans-serif; }
  .custom-cats-section .head p { color: var(--muted); font-weight: 500; font-size: 1.04rem; }
  .cats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; max-width: 1240px; margin: 0 auto; padding-inline: var(--gutter); }
  @media(max-width: 960px) { .cats { grid-template-columns: repeat(2, 1fr); } }
  @media(max-width: 520px) { .cats { grid-template-columns: 1fr 1fr; } }
  .cat { display: block; color: inherit; text-decoration: none; background: var(--white); border: 2px solid var(--ink); border-radius: 3px; padding: 18px 16px 16px; text-align: center; transition: transform .12s, box-shadow .12s; position: relative; }
  .cat:hover { transform: translateY(-3px); box-shadow: 6px 6px 0 var(--ink); }
  .cat svg { width: 100%; height: 96px; margin-bottom: 10px; }
  .cat .cl { stroke: var(--ink); stroke-width: 2; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .cat .fl { stroke: rgba(0, 0, 0, .42); stroke-width: 2; stroke-dasharray: 4 3; fill: none; }
  .cat-yellow { display: grid; place-content: center; background: var(--yellow); }
  .cat-yellow h3 { font-size: 1.1rem; font-family: 'Space Grotesk', sans-serif; }
  .cat-yellow p { color: var(--ink); }
</style>

<section class="custom-cats-section" id="cats">
  <div class="wrap" style="max-width:1240px;margin:0 auto;padding-inline:var(--gutter)">
    <div class="head reveal">
      <p class="kick">{{ section.settings.kicker }}</p>
      <h2>{{ section.settings.headline }}</h2>
      <p>{{ section.settings.subheadline }}</p>
    </div>
  </div>
  <div class="cats">
    {%- for block in section.blocks -%}
      {%- if block.type == 'category' -%}
        <a class="cat reveal" href="{{ block.settings.link }}">
          {{ block.settings.svg_code }}
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </a>
      {%- elsif block.type == 'themed_drop' -%}
        <a class="cat cat-yellow reveal" href="{{ block.settings.link }}">
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
