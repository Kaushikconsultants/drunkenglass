<section class="sec wrap" id="dg-gifting-tiles">
  <div class="sec-head">
    <div>
      <h2 class="h2">{{ section.settings.heading | default: 'Gifting, Sorted' }}</h2>
      <p class="sub">{{ section.settings.subheading | default: 'For the person who already has three Stanley cups they don’t need.' }}</p>
    </div>
    <a class="link" href="/pages/gifting">See the Gift Shop</a>
  </div>

  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px">
    <!-- Tile 1: Host -->
    <a class="pcard" href="/pages/gifting#host" style="background:#f8fac4;border:2px solid var(--ink);border-radius:var(--r);box-shadow:var(--sh);padding:24px;text-decoration:none;display:flex;flex-direction:column;justify-content:space-between">
      <div>
        <span class="badge b-lime" style="position:static;display:inline-block;margin-bottom:8px">Dinner Parties</span>
        <h3 style="font:700 22px var(--f-head);margin-bottom:6px">For The Host</h3>
        <p style="color:var(--muted);font-size:14px">Friendsgiving, cocktail nights & housewarmings</p>
      </div>
      <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-top:24px">
        <img src="{{ 'the-wobble--electric-blue.png' | asset_url }}" alt="Host Gift" width="90" height="110" loading="lazy">
        <span class="btn btn-ink sm">Shop Host Picks</span>
      </div>
    </a>

    <!-- Tile 2: Bestie -->
    <a class="pcard" href="/pages/gifting#bestie" style="background:#ffe1e8;border:2px solid var(--ink);border-radius:var(--r);box-shadow:var(--sh);padding:24px;text-decoration:none;display:flex;flex-direction:column;justify-content:space-between">
      <div>
        <span class="badge b-pink" style="position:static;display:inline-block;margin-bottom:8px">Dopamine Sips</span>
        <h3 style="font:700 22px var(--f-head);margin-bottom:6px">For The Bestie</h3>
        <p style="color:var(--muted);font-size:14px">Loud colors, cherries, and inside jokes</p>
      </div>
      <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-top:24px">
        <img src="{{ 'r3-r3co240.webp' | asset_url }}" alt="Bestie Gift" width="90" height="110" loading="lazy" style="object-fit:contain">
        <span class="btn btn-ink sm">Shop Bestie Picks</span>
      </div>
    </a>

    <!-- Tile 3: Couple -->
    <a class="pcard" href="/pages/gifting#couple" style="background:#dfe8ff;border:2px solid var(--ink);border-radius:var(--r);box-shadow:var(--sh);padding:24px;text-decoration:none;display:flex;flex-direction:column;justify-content:space-between">
      <div>
        <span class="badge b-blue" style="position:static;display:inline-block;margin-bottom:8px">Date Night</span>
        <h3 style="font:700 22px var(--f-head);margin-bottom:6px">For The Couple</h3>
        <p style="color:var(--muted);font-size:14px">Matching pairs that make coffee feel like a date</p>
      </div>
      <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-top:24px">
        <img src="{{ 'heart-eyes-mug--berry-crush.png' | asset_url }}" alt="Couple Gift" width="90" height="110" loading="lazy">
        <span class="btn btn-ink sm">Shop Pairs</span>
      </div>
    </a>

    <!-- Tile 4: Digital Gift Cards -->
    <a class="pcard" href="/products/digital-gift-card" style="background:#dfe8ff;border:2px solid var(--ink);border-radius:var(--r);box-shadow:var(--sh);padding:24px;text-decoration:none;display:flex;flex-direction:column;justify-content:space-between">
      <div>
        <span class="badge b-lime" style="position:static;display:inline-block;margin-bottom:8px">Instant Email</span>
        <h3 style="font:700 22px var(--f-head);margin-bottom:6px">Digital Gift Cards</h3>
        <p style="color:var(--muted);font-size:14px">Let them pick their favorite shape ($25 – $150)</p>
      </div>
      <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-top:24px">
        <span class="price" style="font-size:28px;font-weight:700">$25+</span>
        <span class="btn btn-blue sm">Send Card</span>
      </div>
    </a>
  </div>
</section>

{% schema %}
{
  "name": "DG Gifting Tiles",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Gifting, Sorted"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "For the person who already has three Stanley cups they don’t need."
    }
  ],
  "presets": [
    {
      "name": "DG Gifting Tiles"
    }
  ]
}
{% endschema %}
