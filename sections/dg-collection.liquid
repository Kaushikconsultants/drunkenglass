<section class="wrap sec" id="dg-collection" style="padding-top:16px">
  <!-- Page Header -->
  <header class="page-head" style="margin-bottom:24px">
    <h1 class="h2" id="dgShopTitle">{{ collection.title | default: 'shop all glasses' | downcase }}</h1>
    <p class="sub" id="dgShopSub">{{ collection.description | default: 'every glass we make, in every color we make it. tap the dots to switch colors.' }}</p>
  </header>

  <!-- Type Navigation Tabs -->
  <div class="tabs" role="tablist" style="margin-bottom:24px;overflow-x:auto;padding-bottom:8px">
    <a class="tab on" href="/collections/all">all glasses</a>
    <a class="tab" href="/collections/tumblers">tumblers</a>
    <a class="tab" href="/collections/coffee-cups">coffee cups</a>
    <a class="tab" href="/collections/teacups">teacups</a>
    <a class="tab" href="/collections/cocktail-glasses">cocktail glasses</a>
    <a class="tab" href="/collections/sets-and-accessories">sets & extras</a>
    <a class="tab" href="/pages/build-a-set">build a set</a>
  </div>

  <!-- Filters & Sort Bar -->
  <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;margin-bottom:24px;border-bottom:2px solid var(--ink);padding-bottom:16px">
    <!-- Filter Chips -->
    <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
      <span style="font:700 13px var(--f-head)">filter:</span>
      <button class="chip" type="button" data-filter="under30">under $30</button>
      <button class="chip" type="button" data-filter="30to39">$30 to $39</button>
      <button class="chip" type="button" data-filter="40plus">$40+</button>
      <button class="chip" type="button" data-filter="blue">blue</button>
      <button class="chip" type="button" data-filter="berry">berry</button>
      <button class="chip" type="button" data-filter="lime">lime</button>
    </div>

    <!-- Count & Sort -->
    <div style="display:flex;align-items:center;gap:16px">
      <span class="mono" style="font-size:14px;color:var(--muted)">19 glasses</span>
      <select class="btn sm" style="font-size:13px;padding:0 12px;background:#fff">
        <option value="featured">sort: featured</option>
        <option value="price-asc">price: low to high</option>
        <option value="price-desc">price: high to low</option>
        <option value="newest">newest first</option>
      </select>
    </div>
  </div>

  <!-- Product Grid -->
  <div class="grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:24px">
    <!-- Product 1 -->
    <article class="pcard" data-handle="cherry-bomb">
      <a class="pmedia" href="/products/cherry-bomb" style="--bg:#ffe1e8" tabindex="-1">
        <span class="badge b-pink">new</span>
        <img class="pcard-img" src="{{ 'cherry-bomb--blush.png' | asset_url }}" alt="cherry bomb tumbler" width="240" height="300" loading="lazy">
      </a>
      <button class="heart" type="button" aria-label="save to wishlist" data-wishlist="cherry-bomb">
        <svg viewBox="0 0 24 24"><path d="M12 20s-7.5-4.6-9.2-9.3C1.6 7.3 3.8 4 7.3 4c2 0 3.5 1.1 4.7 2.8C13.2 5.1 14.7 4 16.7 4c3.5 0 5.7 3.3 4.5 6.7C19.5 15.4 12 20 12 20z" fill="none" stroke="currentColor" stroke-width="2.2"/></svg>
      </button>
      <div class="pinfo">
        <a class="pname" href="/products/cherry-bomb">cherry bomb tumbler</a>
        <span class="pmeta">in blush</span>
        <div class="prow"><span class="price">$36</span></div>
        <div class="pfoot">
          <div class="sw" role="group" aria-label="colors">
            <button class="swb on" style="--c:#ef426f" data-color="blush" data-img="{{ 'cherry-bomb--blush.png' | asset_url }}" data-bg="#ffe1e8" aria-label="blush" aria-pressed="true"></button>
            <button class="swb" style="--c:#ffffff" data-color="clear cherry" data-img="{{ 'cherry-bomb--clear-cherry.png' | asset_url }}" data-bg="#f2f1f0" aria-label="clear cherry" aria-pressed="false"></button>
          </div>
          <button class="qadd" type="button" data-add="cherry-bomb">add to bag</button>
        </div>
      </div>
    </article>

    <!-- Product 2 -->
    <article class="pcard" data-handle="the-wobble">
      <a class="pmedia" href="/products/the-wobble" style="--bg:#dfe8ff" tabindex="-1">
        <span class="badge b-lime">hero design</span>
        <img class="pcard-img" src="{{ 'the-wobble--electric-blue.png' | asset_url }}" alt="the wobble tumbler" width="240" height="300" loading="lazy">
      </a>
      <button class="heart" type="button" aria-label="save to wishlist" data-wishlist="the-wobble">
