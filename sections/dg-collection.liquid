            <button class="swb" style="--c:#ffffff" data-color="clear" data-img="{{ 'the-wobble--clear.png' | asset_url }}" data-bg="#f2f1f0" aria-label="clear" aria-pressed="false"></button>
            <button class="swb" style="--c:#eaef29" data-color="lime soda" data-img="{{ 'the-wobble--lime-soda.png' | asset_url }}" data-bg="#f8fac4" aria-label="lime soda" aria-pressed="false"></button>
            <button class="swb" style="--c:#ef426f" data-color="berry" data-img="{{ 'the-wobble--berry.png' | asset_url }}" data-bg="#ffe1e8" aria-label="berry" aria-pressed="false"></button>
          </div>
          <button class="qadd" type="button" data-add="the-wobble">add to bag</button>
