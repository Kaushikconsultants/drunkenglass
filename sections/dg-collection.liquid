      <a class="pmedia" href="/products/starstruck-coupe" style="--bg:#dfe8ff" tabindex="-1">
        <span class="badge b-blue">Staff Pick</span>
        <img class="pcard-img" src="{{ 'starstruck-coupe--deep-blue.png' | asset_url }}" alt="starstruck coupe" width="240" height="300" loading="lazy">
      </a>
      <button class="heart" type="button" aria-label="Save to wishlist" data-wishlist="starstruck-coupe">
        <svg viewBox="0 0 24 24"><path d="M12 20s-7.5-4.6-9.2-9.3C1.6 7.3 3.8 4 7.3 4c2 0 3.5 1.1 4.7 2.8C13.2 5.1 14.7 4 16.7 4c3.5 0 5.7 3.3 4.5 6.7C19.5 15.4 12 20 12 20z" fill="none" stroke="currentColor" stroke-width="2.2"/></svg>
