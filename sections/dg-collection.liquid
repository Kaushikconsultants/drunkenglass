<section class="wrap sec" id="dg-collection" style="padding-top:16px">
  <!-- Page Header -->
  <header class="page-head" style="margin-bottom:24px">
    <h1 class="h2" id="dgShopTitle">{{ collection.title | default: 'Shop All Glasses' }}</h1>
    <p class="sub" id="dgShopSub">{{ collection.description | default: 'Handcrafted Borosilicate Glassware from R3 Exports (Agra Furnace). Thermal shock resistant (-20°C to 150°C).' }}</p>
  </header>

  <!-- Type Navigation Tabs -->
  <div class="tabs" role="tablist" style="margin-bottom:24px;overflow-x:auto;padding-bottom:8px">
    <a class="tab {% if collection.handle == 'all' or collection.handle == blank %}on{% endif %}" href="/collections/all">All Glasses</a>
    <a class="tab {% if collection.handle == 'tumblers' %}on{% endif %}" href="/collections/tumblers">Tumblers</a>
    <a class="tab {% if collection.handle == 'mugs' %}on{% endif %}" href="/collections/mugs">Mugs & Cups</a>
    <a class="tab {% if collection.handle == 'double-glass' %}on{% endif %}" href="/collections/double-glass">Double Wall</a>
    <a class="tab {% if collection.handle == 'cocktail-glasses' %}on{% endif %}" href="/collections/cocktail-glasses">Cocktail Glasses</a>
    <a class="tab {% if collection.handle == 'wine-glasses' %}on{% endif %}" href="/collections/wine-glasses">Wine Glasses</a>
  </div>

  <!-- Filters & Sort Bar -->
  <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;margin-bottom:24px;border-bottom:2px solid var(--ink);padding-bottom:16px">
    <!-- Filter Chips -->
    <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
      <span style="font:700 13px var(--f-head)">Filter:</span>
      <button class="chip" type="button" data-filter="under200">Under ₹200</button>
      <button class="chip" type="button" data-filter="under300">Under ₹300</button>
      <button class="chip" type="button" data-filter="all">All Items</button>
    </div>

    <!-- Count & Sort -->
    <div style="display:flex;align-items:center;gap:16px">
      <span class="mono" style="font-size:14px;color:var(--muted)">
        {% if collection.products.size > 0 %}
          {{ collection.products.size }} Products Available
        {% else %}
          R3 Exports Catalog
        {% endif %}
      </span>
      <select class="btn sm" style="font-size:13px;padding:0 12px;background:#fff">
        <option value="featured">Sort: Featured</option>
        <option value="price-asc">Price: Low to High</option>
        <option value="price-desc">Price: High to Low</option>
        <option value="newest">Newest First</option>
      </select>
    </div>
  </div>

  <!-- Product Grid -->
  <div class="grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:24px">
    {% if collection.products.size > 0 %}
      {% for product in collection.products %}
        <article class="pcard" data-handle="{{ product.handle }}">
          <a class="pmedia" href="{{ product.url }}" style="--bg:#f8fac4" tabindex="-1">
            <span class="badge b-lime">{{ product.type | default: 'Borosilicate' }}</span>
            {% if product.featured_image %}
              <img class="pcard-img" src="{{ product.featured_image | image_url: width: 360 }}" alt="{{ product.title | escape }}" width="240" height="300" loading="lazy" style="object-fit:contain">
            {% else %}
              <img class="pcard-img" src="{{ 'r3-r3tu113.webp' | asset_url }}" alt="{{ product.title | escape }}" width="240" height="300" loading="lazy" style="object-fit:contain">
            {% endif %}
          </a>
          <button class="heart" type="button" aria-label="Save to wishlist" data-wishlist="{{ product.handle }}">
            <svg viewBox="0 0 24 24"><path d="M12 20s-7.5-4.6-9.2-9.3C1.6 7.3 3.8 4 7.3 4c2 0 3.5 1.1 4.7 2.8C13.2 5.1 14.7 4 16.7 4c3.5 0 5.7 3.3 4.5 6.7C19.5 15.4 12 20 12 20z" fill="none" stroke="currentColor" stroke-width="2.2"/></svg>
          </button>
          <div class="pinfo">
            <a class="pname" href="{{ product.url }}">{{ product.title }}</a>
            <span class="pmeta">SKU: {{ product.variants.first.sku }} · B2B Grade</span>
            <div class="prow">
              <span class="price">${{ product.price | divided_by: 100.0 | round }}</span>
              {% if product.compare_at_price > product.price %}
                <span class="strike" style="font-size:13px;color:var(--muted);text-decoration:line-through;margin-left:6px">${{ product.compare_at_price | divided_by: 100.0 | round }}</span>
              {% endif %}
            </div>
            <div class="pfoot">
              <button class="qadd full" type="button" data-add="{{ product.variants.first.id }}">Add to Bag</button>
            </div>
          </div>
        </article>
      {% endfor %}
    {% else %}
      <!-- Fallback Real R3 Exports Products Cards -->
      <article class="pcard" data-handle="r3-vintage-borosilicate-cocktail-coupe-280ml-r3co240">
        <a class="pmedia" href="/products/r3-vintage-borosilicate-cocktail-coupe-280ml-r3co240" style="--bg:#dfe8ff" tabindex="-1">
          <span class="badge b-blue">Cocktail Coupe</span>
          <img class="pcard-img" src="{{ 'r3-r3co240.webp' | asset_url }}" alt="R3 Vintage Borosilicate Cocktail Coupe 280ml" width="240" height="300" loading="lazy" style="object-fit:contain">
        </a>
        <div class="pinfo">
          <a class="pname" href="/products/r3-vintage-borosilicate-cocktail-coupe-280ml-r3co240">R3 Cocktail Coupe 280ml</a>
          <span class="pmeta">SKU: R3CO240 · 280 ml</span>
          <div class="prow"><span class="price">$38</span><span class="strike" style="font-size:13px;color:var(--muted);text-decoration:line-through;margin-left:6px">MRP $68</span></div>
          <div class="pfoot"><button class="qadd full" type="button">Add to Bag</button></div>
        </div>
      </article>

      <article class="pcard" data-handle="r3-fluted-borosilicate-tumbler-glass-380ml-r3tu113">
        <a class="pmedia" href="/products/r3-fluted-borosilicate-tumbler-glass-380ml-r3tu113" style="--bg:#f8fac4" tabindex="-1">
          <span class="badge b-lime">Tumbler Glass</span>
          <img class="pcard-img" src="{{ 'r3-r3tu113.webp' | asset_url }}" alt="R3 Fluted Borosilicate Tumbler Glass 380ml" width="240" height="300" loading="lazy" style="object-fit:contain">
        </a>
        <div class="pinfo">
          <a class="pname" href="/products/r3-fluted-borosilicate-tumbler-glass-380ml-r3tu113">R3 Fluted Tumbler 380ml</a>
          <span class="pmeta">SKU: R3TU113 · 380 ml</span>
          <div class="prow"><span class="price">$32</span><span class="strike" style="font-size:13px;color:var(--muted);text-decoration:line-through;margin-left:6px">MRP $54</span></div>
          <div class="pfoot"><button class="qadd full" type="button">Add to Bag</button></div>
        </div>
      </article>

      <article class="pcard" data-handle="r3-classic-borosilicate-coffee-mug-350ml-r3tc117">
        <a class="pmedia" href="/products/r3-classic-borosilicate-coffee-mug-350ml-r3tc117" style="--bg:#ffe1e8" tabindex="-1">
          <span class="badge b-pink">Coffee Mug</span>
          <img class="pcard-img" src="{{ 'r3-r3tc117.webp' | asset_url }}" alt="R3 Classic Borosilicate Coffee Mug 350ml" width="240" height="300" loading="lazy" style="object-fit:contain">
        </a>
        <div class="pinfo">
          <a class="pname" href="/products/r3-classic-borosilicate-coffee-mug-350ml-r3tc117">R3 Coffee Mug 350ml</a>
          <span class="pmeta">SKU: R3TC117 · 350 ml</span>
          <div class="prow"><span class="price">$28</span><span class="strike" style="font-size:13px;color:var(--muted);text-decoration:line-through;margin-left:6px">MRP $48</span></div>
          <div class="pfoot"><button class="qadd full" type="button">Add to Bag</button></div>
        </div>
      </article>

      <article class="pcard" data-handle="r3-insulated-double-wall-borosilicate-glass-270ml-r3dg107">
        <a class="pmedia" href="/products/r3-insulated-double-wall-borosilicate-glass-270ml-r3dg107" style="--bg:#f2f1f0" tabindex="-1">
          <span class="badge b-lime">Double Wall</span>
          <img class="pcard-img" src="{{ 'r3-r3dg107.webp' | asset_url }}" alt="R3 Insulated Double Wall Borosilicate Glass 270ml" width="240" height="300" loading="lazy" style="object-fit:contain">
        </a>
        <div class="pinfo">
          <a class="pname" href="/products/r3-insulated-double-wall-borosilicate-glass-270ml-r3dg107">R3 Double Wall 270ml</a>
          <span class="pmeta">SKU: R3DG107 · 270 ml</span>
          <div class="prow"><span class="price">$34</span><span class="strike" style="font-size:13px;color:var(--muted);text-decoration:line-through;margin-left:6px">MRP $58</span></div>
          <div class="pfoot"><button class="qadd full" type="button">Add to Bag</button></div>
        </div>
      </article>
    {% endif %}
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('#dg-collection .chip').forEach(function(chip) {
    chip.addEventListener('click', function() {
      chip.classList.toggle('on');
    });
  });
});
</script>

{% schema %}
{
  "name": "DG Collection Grid",
  "settings": [],
  "presets": [
    {
      "name": "DG Collection Grid"
    }
  ]
}
{% endschema %}
