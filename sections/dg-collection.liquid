  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Swatch interactions in collection grid
  document.querySelectorAll('#dg-collection .swb').forEach(function(swb) {
    swb.addEventListener('click', function(e) {
      e.stopPropagation();
      const parentCard = swb.closest('.pcard');
      if (!parentCard) return;

      parentCard.querySelectorAll('.swb').forEach(b => {
        b.classList.remove('on');
        b.setAttribute('aria-pressed', 'false');
      });
      swb.classList.add('on');
      swb.setAttribute('aria-pressed', 'true');

      const img = parentCard.querySelector('.pcard-img');
      const media = parentCard.querySelector('.pmedia');
      const meta = parentCard.querySelector('.pmeta');

      if (img && swb.dataset.img) img.src = swb.dataset.img;
      if (media && swb.dataset.bg) media.style.setProperty('--bg', swb.dataset.bg);
      if (meta && swb.dataset.color) meta.textContent = 'in ' + swb.dataset.color;
    });
  });

  // Filter chips active toggle
  document.querySelectorAll('#dg-collection .chip').forEach(function(chip) {
    chip.addEventListener('click', function() {
      chip.classList.toggle('on');
    });
  });
});
</script>

