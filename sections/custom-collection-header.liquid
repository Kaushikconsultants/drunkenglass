<style>
/* Collection Page Styles */
.dg-collection-header { padding-block: clamp(34px, 6vw, 58px) 6px; }
.dg-collection-header .kick { color: var(--blue); }
.dg-collection-header h1 { font-weight: 700; font-size: clamp(2rem, 6vw, 3.4rem); line-height: 1; letter-spacing: -.02em; text-transform: uppercase; margin: 12px 0 8px; }
.dg-collection-header p { color: var(--muted); font-weight: 500; max-width: 52ch; }

/* Category filter pills */
.dg-cat-pills { display: flex; gap: 10px; overflow-x: auto; padding: 22px 0 6px; scroll-snap-type: x mandatory; position: sticky; top: 57px; background: var(--paper); z-index: 20; max-width: 1240px; margin: 0 auto; padding-inline: var(--gutter); }
.dg-catpill { flex: 0 0 auto; scroll-snap-align: start; cursor: pointer; border: 2px solid var(--ink); background: var(--white); border-radius: 2px; padding: 10px 16px; font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: .72rem; letter-spacing: .04em; text-transform: uppercase; transition: background .15s, color .15s; color: inherit; text-decoration: none; }
.dg-catpill:hover { background: var(--paper); }
.dg-catpill.active { background: var(--ink); color: var(--paper); }

/* Filter bar */
.dg-fbar { display: flex; flex-wrap: wrap; gap: 12px; justify-content: space-between; align-items: center; padding: 14px 0 4px; max-width: 1240px; margin: 0 auto; padding-inline: var(--gutter); }
.dg-fbar .count { font-family: 'Space Grotesk', sans-serif; font-size: .72rem; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; }
.dg-fbar-sort { display: flex; align-items: center; gap: 8px; }
.dg-fbar label { font-family: 'Space Grotesk', sans-serif; font-size: .62rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
.dg-fbar select { border: 2px solid var(--ink); border-radius: 2px; background: var(--white); font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: .8rem; padding: 8px 10px; }
.dg-fbar select:focus { outline: 3px solid var(--blue); outline-offset: 1px; }

/* Product grid */
.dg-product-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; padding-block: 16px 44px; max-width: 1240px; margin: 0 auto; padding-inline: var(--gutter); }
@media(max-width: 1000px) { .dg-product-grid { grid-template-columns: repeat(3, 1fr); } }
@media(max-width: 760px) { .dg-product-grid { grid-template-columns: 1fr 1fr; } }
@media(max-width: 460px) { .dg-product-grid { grid-template-columns: 1fr; } }
.dg-pcard { position: relative; display: block; background: var(--white); border: 2px solid var(--ink); border-radius: 4px; padding: 18px; transition: transform .12s, box-shadow .12s; color: var(--ink); }
.dg-pcard:hover { transform: translateY(-3px); box-shadow: 6px 6px 0 var(--ink); }
.dg-tag { position: absolute; top: 12px; left: 12px; font-family: 'Space Grotesk', sans-serif; font-size: .55rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; padding: 4px 8px; border: 1.6px solid var(--ink); }
.dg-tag.best { background: var(--yellow); color: var(--ink); }
.dg-tag.new { background: var(--blue); color: #fff; border-color: var(--blue); }
.dg-card-img { width: 100%; aspect-ratio: 1/1; object-fit: cover; display: block; margin-bottom: 12px; border-radius: 2px; background: var(--paper); }
.dg-card-img-placeholder { width: 100%; height: 160px; display: flex; align-items: center; justify-content: center; background: var(--paper); margin-bottom: 12px; border-radius: 2px; }
.dg-pname { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 1.05rem; text-transform: uppercase; text-align: center; }
.dg-pmeta { font-family: 'Space Grotesk', sans-serif; font-size: .62rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); text-align: center; margin-bottom: 6px; }
.dg-pprice { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 1.1rem; color: var(--blue); text-align: center; }
.dg-ppre { font-family: 'Space Grotesk', sans-serif; font-size: .6rem; font-weight: 600; color: var(--muted); text-align: center; margin-top: 1px; }
.dg-add-btn { margin-top: 12px; cursor: pointer; width: 100%; background: var(--ink); color: var(--paper); border: 2px solid var(--ink); border-radius: 2px; font-family: 'Space Grotesk', sans-serif; font-weight: 500; font-size: .64rem; letter-spacing: .1em; text-transform: uppercase; padding: 10px; transition: background .2s, color .2s; }
.dg-add-btn:hover { background: var(--blue); border-color: var(--blue); color: #fff; }
</style>

<div class="dg-collection-header">
  <div class="dg-wrap">
    <p class="kick">{{ section.settings.kicker }}</p>
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <p>{{ collection.description }}</p>
    {%- elsif section.settings.description != blank -%}
      <p>{{ section.settings.description }}</p>
    {%- endif -%}
  </div>
</div>

<!-- Category filter pills linking to collections -->
<nav class="dg-cat-pills" aria-label="Category filter">
  {%- if section.settings.show_category_pills -%}
      {%- for coll in collections -%}
        {%- if coll.all_products_count > 0 -%}
          <a href="{{ coll.url }}" class="dg-catpill{% if collection.handle == coll.handle %} active{% endif %}">{{ coll.title }}</a>
        {%- endif -%}
      {%- endfor -%}
  {%- endif -%}
</nav>

{% schema %}
{
  "name": "Collection Header",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker text",
      "default": "Shop the collection"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Fallback description (if collection has no description)",
      "default": "Hand-cut lead-free crystal, drawn to a fill line. Available in mixed colours as shown."
    },
    {
      "type": "checkbox",
      "id": "show_category_pills",
      "label": "Show category filter pills",
      "default": true
    },
    {
      "type": "link_list",
      "id": "category_menu",
      "label": "Category menu for pills",
      "default": "main-menu"
    }
  ],
  "presets": [
    {
      "name": "Collection Header"
    }
  ]
}
{% endschema %}
