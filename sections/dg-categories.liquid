<section class="sec wrap" style="padding-top:8px" id="dg-categories">
  <div class="sec-head">
    <div>
      <h2 class="h2">{{ section.settings.heading | default: 'What Are You Drinking?' }}</h2>
      <p class="sub">{{ section.settings.subheading | default: 'Five furnace-crafted categories. 100% Thermal Shock Resistant Borosilicate Glass.' }}</p>
    </div>
    <a class="link" href="/collections/all">See All Glasses</a>
  </div>

  <div class="cats">
    <a class="cat" href="/collections/tumblers" style="--bg:#f8fac4">
      <div class="art">
        <img src="{{ 'r3-r3tu113.webp' | asset_url }}" alt="Tumblers" width="130" height="160" loading="lazy" style="object-fit:contain;max-height:160px">
      </div>
      <div class="lab">
        <b>Tumblers</b>
        <small>Iced coffee, cold brew, highball</small>
        <br>
        <span class="price">From $26</span>
      </div>
    </a>

    <a class="cat" href="/collections/mugs" style="--bg:#ffe1e8">
      <div class="art">
        <img src="{{ 'r3-r3tc117.webp' | asset_url }}" alt="Mugs" width="130" height="160" loading="lazy" style="object-fit:contain;max-height:160px">
      </div>
      <div class="lab">
        <b>Mugs & Cups</b>
        <small>Boiling espresso and chai safe</small>
        <br>
        <span class="price">From $24</span>
      </div>
    </a>

    <a class="cat" href="/collections/double-glass" style="--bg:#f2f1f0">
      <div class="art">
        <img src="{{ 'r3-r3dg107.webp' | asset_url }}" alt="Double Wall Glasses" width="130" height="160" loading="lazy" style="object-fit:contain;max-height:160px">
      </div>
      <div class="lab">
        <b>Double Wall</b>
        <small>Thermal insulated, cool to touch</small>
        <br>
        <span class="price">From $32</span>
      </div>
    </a>

    <a class="cat" href="/collections/cocktail-glasses" style="--bg:#dfe8ff">
      <div class="art">
        <img src="{{ 'r3-r3co240.webp' | asset_url }}" alt="Cocktail Glasses" width="130" height="160" loading="lazy" style="object-fit:contain;max-height:160px">
      </div>
      <div class="lab">
        <b>Cocktail Coupes</b>
        <small>Martini, coupe, bar craft</small>
        <br>
        <span class="price">From $34</span>
      </div>
    </a>

    <a class="cat" href="/collections/wine-glasses" style="--bg:#eaef29">
      <div class="art">
        <img src="{{ 'r3-r3wg237.webp' | asset_url }}" alt="Wine Glasses" width="130" height="160" loading="lazy" style="object-fit:contain;max-height:160px">
      </div>
      <div class="lab">
        <b>Wine Glasses</b>
        <small>Ultra fine stems & balloons</small>
        <br>
        <span class="price">From $34</span>
      </div>
    </a>
  </div>
</section>

{% schema %}
{
  "name": "DG Categories Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Are You Drinking?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Five furnace-crafted categories. 100% Thermal Shock Resistant Borosilicate Glass."
    }
  ],
  "presets": [
    {
      "name": "DG Categories Grid"
    }
  ]
}
{% endschema %}
