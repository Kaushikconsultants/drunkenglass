<section class="sec wrap" style="padding-top:8px" id="dg-categories">
  <div class="sec-head">
    <div>
      <h2 class="h2">{{ section.settings.heading | default: 'what are you drinking?' }}</h2>
      <p class="sub">{{ section.settings.subheading | default: 'five shapes of happy. pick your poison (it’s cold coffee, relax).' }}</p>
    </div>
    <a class="link" href="/collections/all">see all glasses</a>
  </div>

  <div class="cats">
    <a class="cat" href="/collections/tumblers" style="--bg:#f8fac4">
      <div class="art">
        <img src="{{ 'lemon-drop--sunny.png' | asset_url }}" alt="tumblers" width="120" height="150" loading="lazy">
      </div>
      <div class="lab">
        <b>tumblers</b>
        <small>iced coffee, cold brew, lemonade</small>
        <br>
        <span class="price">from $32</span>
      </div>
    </a>

    <a class="cat" href="/collections/coffee-cups" style="--bg:#ffe1e8">
      <div class="art">
        <img src="{{ 'heart-eyes-mug--berry-crush.png' | asset_url }}" alt="coffee cups" width="120" height="150" loading="lazy">
      </div>
      <div class="lab">
        <b>coffee cups</b>
        <small>for the 9am call you joined on mute</small>
        <br>
        <span class="price">from $28</span>
      </div>
    </a>

    <a class="cat" href="/collections/teacups" style="--bg:#f2f1f0">
      <div class="art">
        <img src="{{ 'cutting-chai-set--clear.png' | asset_url }}" alt="teacups" width="120" height="150" loading="lazy">
      </div>
      <div class="lab">
        <b>teacups</b>
        <small>chai, matcha and slow mornings</small>
        <br>
        <span class="price">from $26</span>
      </div>
    </a>

    <a class="cat" href="/collections/cocktail-glasses" style="--bg:#dfe8ff">
      <div class="art">
        <img src="{{ 'blue-moon-coupe--blue-moon.png' | asset_url }}" alt="cocktail glasses" width="120" height="150" loading="lazy">
      </div>
      <div class="lab">
        <b>cocktail glasses</b>
        <small>mocktails count. we don’t judge</small>
        <br>
        <span class="price">from $34</span>
      </div>
    </a>

    <a class="cat" href="/collections/sets-and-accessories" style="--bg:#eaef29">
      <div class="art">
        <img src="{{ 'coaster-set.png' | asset_url }}" alt="sets and extras" width="120" height="150" loading="lazy">
      </div>
      <div class="lab">
        <b>sets & extras</b>
        <small>straws, lids, party packs</small>
        <br>
        <span class="price">from $12</span>
      </div>
    </a>
  </div>
</section>

{% schema %}
{
  "name": "DG Categories Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "what are you drinking?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "five shapes of happy. pick your poison (it’s cold coffee, relax)."
    }
  ],
  "presets": [
    {
      "name": "DG Categories Grid"
    }
  ]
}
{% endschema %}
