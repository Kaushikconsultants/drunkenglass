<section class="wrap sec" id="dg-main-product" style="padding-top:16px">
  {% assign current_price = product.price | divided_by: 100.0 | round %}
  {% assign current_compare = product.compare_at_price | divided_by: 100.0 | round %}
  {% if current_price == 0 %}
    {% assign current_price = 36 %}
  {% endif %}
  {% if current_compare <= current_price %}
    {% assign current_compare = current_price | times: 1.75 | round %}
  {% endif %}

  <!-- Breadcrumbs -->
  <nav class="crumbs" aria-label="breadcrumbs" style="margin-bottom:16px;font:500 13px var(--f-head);color:var(--muted)">
    <a href="/collections/all" style="text-decoration:none">Shop</a>
    <span style="margin:0 6px">/</span>
    <a href="/collections/{{ product.collections.first.handle | default: 'all' }}" style="text-decoration:none">{{ product.collections.first.title | default: product.type | default: 'Glassware' }}</a>
    <span style="margin:0 6px">/</span>
    <span style="color:var(--ink);font-weight:700">{{ product.title }}</span>
  </nav>

  <div class="pdp-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:clamp(24px,5vw,56px);align-items:start">
    <!-- Left: Gallery -->
    <div class="gallery" id="dgGallery">
      <div class="g-main" style="background:#f8fac4;border:2px solid var(--ink);border-radius:var(--r);box-shadow:var(--sh);aspect-ratio:1;display:flex;align-items:center;justify-content:center;overflow:hidden;position:relative">
        <span class="badge b-lime" style="position:absolute;top:16px;left:16px">{{ product.type | default: 'Borosilicate Glass' }}</span>
        {% if product.featured_image %}
          <img id="dgMainImg" src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.title | escape }}" width="460" height="460" style="max-height:88%;max-width:88%;object-fit:contain">
        {% else %}
          <img id="dgMainImg" src="{{ 'r3-r3co240.webp' | asset_url }}" alt="{{ product.title | escape }}" width="460" height="460" style="max-height:88%;max-width:88%;object-fit:contain">
        {% endif %}
      </div>

      <!-- Thumbnails (if multiple images) -->
      {% if product.images.size > 1 %}
        <div style="display:flex;gap:12px;margin-top:16px;flex-wrap:wrap">
          {% for img in product.images %}
            <button class="g-thumb {% if forloop.first %}on{% endif %}" type="button" style="border:2px solid {% if forloop.first %}var(--ink){% else %}var(--rule){% endif %};border-radius:var(--r);padding:4px;background:#fff;width:72px;height:72px;cursor:pointer" data-img="{{ img | image_url: width: 700 }}">
              <img src="{{ img | image_url: width: 120 }}" alt="{{ product.title }}" width="60" height="60" style="object-fit:contain;height:100%;width:100%">
            </button>
          {% endfor %}
        </div>
      {% endif %}

      <!-- 4 Visual Benefit Badges below gallery on desktop -->
      <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-top:20px">
        <div style="background:#fff;border:1.5px solid var(--ink);border-radius:var(--r);padding:12px;display:flex;align-items:center;gap:10px">
          <span style="font-size:22px;flex-shrink:0">❄️🔥</span>
          <div style="min-width:0">
            <b style="font-size:12.5px;display:block;line-height:1.2">Thermal Shock Safe</b>
            <span style="font-size:11px;color:var(--muted)">-20°C to 150°C Safe</span>
          </div>
        </div>

        <div style="background:#fff;border:1.5px solid var(--ink);border-radius:var(--r);padding:12px;display:flex;align-items:center;gap:10px">
          <span style="font-size:22px;flex-shrink:0">💎</span>
          <div style="min-width:0">
            <b style="font-size:12.5px;display:block;line-height:1.2">Pure Borosilicate</b>
            <span style="font-size:11px;color:var(--muted)">Lead & Cadmium Free</span>
          </div>
        </div>

        <div style="background:#fff;border:1.5px solid var(--ink);border-radius:var(--r);padding:12px;display:flex;align-items:center;gap:10px">
          <span style="font-size:22px;flex-shrink:0">🧼</span>
          <div style="min-width:0">
            <b style="font-size:12.5px;display:block;line-height:1.2">Dishwasher Proof</b>
            <span style="font-size:11px;color:var(--muted)">Never Clouds or Stains</span>
          </div>
        </div>

        <div style="background:#fff;border:1.5px solid var(--ink);border-radius:var(--r);padding:12px;display:flex;align-items:center;gap:10px">
          <span style="font-size:22px;flex-shrink:0">🛡️</span>
          <div style="min-width:0">
            <b style="font-size:12.5px;display:block;line-height:1.2">Free Replacement</b>
            <span style="font-size:11px;color:var(--muted)">100% Breakage Insured</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Right: Buy Column & High-Converting Details -->
    <div class="pdp-info" style="display:flex;flex-direction:column;gap:20px">
      <div>
        <span class="chip" style="height:28px;padding:0 12px;font-size:12px;margin-bottom:8px;font-weight:700;display:inline-block">
          {{ product.vendor | default: 'R3 Exports' }} · {{ product.type | default: 'Borosilicate Glass' }}
        </span>
        <h1 class="pdp-name" style="font:700 clamp(28px,3.8vw,44px)/1.1 var(--f-head);margin:8px 0;letter-spacing:-0.02em">
          {{ product.title }}
        </h1>
        <p class="pdp-line" style="color:var(--muted);font-size:15px;margin:4px 0 0">
          Model SKU: <strong>{{ product.variants.first.sku }}</strong> · Handcrafted in Agra Furnace (100% Laboratory Borosilicate)
        </p>
      </div>

      <!-- Price Box (Clean USD Dollars) -->
      <div>
        <div class="pdp-price" style="display:flex;align-items:baseline;gap:12px;flex-wrap:wrap">
          <span class="price" id="dgPriceMain" style="font-size:38px;font-weight:700;color:var(--ink)">${{ current_price }}</span>
          {% if current_compare > current_price %}
            <span class="strike" style="color:var(--muted);text-decoration:line-through;font-size:20px">${{ current_compare }}</span>
            <span class="off badge b-pink" style="position:static;display:inline-block">
              Save {{ current_compare | minus: current_price | times: 100.0 | divided_by: current_compare | round }}%
            </span>
          {% endif %}
        </div>
        <p class="tax" style="margin-top:4px;font-size:13px;color:var(--muted)">Sales tax calculated at checkout · Free US Shipping over $75</p>
      </div>

      <!-- Shopify Add to Cart Form -->
      <form action="/cart/add" method="post" enctype="multipart/form-data" id="dgAddToCartForm" style="display:flex;flex-direction:column;gap:18px">
        <input type="hidden" name="id" id="dgVariantId" value="{{ product.variants.first.id }}">
        <input type="hidden" name="quantity" id="dgPackQtyInput" value="1">

        <!-- Pack / Quantity Selector (1, 2, 4, 12 Carton) -->
        <div>
          <p class="lbl" style="font:700 14px var(--f-head);margin-bottom:8px">Select Pack Size & Save:</p>
          <div class="packs" role="radiogroup" aria-label="quantity pack" style="display:grid;grid-template-columns:repeat(2,1fr);gap:10px">
            <!-- Single -->
            <label class="pack-card on" style="border:2px solid var(--ink);border-radius:var(--r);background:var(--lime-t);padding:14px;cursor:pointer;display:block">
              <input type="radio" name="pack_radio" value="1" checked style="display:none">
              <b style="display:block;font-size:15px">Single (1 Piece)</b>
              <span class="mono" style="font-size:14px">${{ current_price }}</span>
            </label>

            <!-- Pair (2) -->
            <label class="pack-card" style="border:2px solid var(--rule);border-radius:var(--r);background:#fff;padding:14px;cursor:pointer;display:block">
              <input type="radio" name="pack_radio" value="2" style="display:none">
              <div style="display:flex;justify-content:space-between">
                <b style="font-size:15px">Pair (2 Pieces)</b>
                <span class="off badge b-pink" style="position:static;font-size:10px">5% Off</span>
              </div>
              <span class="mono" style="font-size:14px">${{ current_price | times: 2 | times: 0.95 | round }}</span>
            </label>

            <!-- Set of 4 -->
            <label class="pack-card" style="border:2px solid var(--rule);border-radius:var(--r);background:#fff;padding:14px;cursor:pointer;display:block">
              <input type="radio" name="pack_radio" value="4" style="display:none">
              <div style="display:flex;justify-content:space-between">
                <b style="font-size:15px">Set of 4</b>
                <span class="off badge b-pink" style="position:static;font-size:10px">10% Off</span>
              </div>
              <span class="mono" style="font-size:14px">${{ current_price | times: 4 | times: 0.90 | round }}</span>
            </label>

            <!-- Master Carton (12) -->
            <label class="pack-card" style="border:2px solid var(--rule);border-radius:var(--r);background:#fff;padding:14px;cursor:pointer;display:block">
              <input type="radio" name="pack_radio" value="12" style="display:none">
              <div style="display:flex;justify-content:space-between">
                <b style="font-size:15px">Carton (12 Pieces)</b>
                <span class="off badge b-pink" style="position:static;font-size:10px">15% Off</span>
              </div>
              <span class="mono" style="font-size:14px">${{ current_price | times: 12 | times: 0.85 | round }}</span>
            </label>
          </div>
        </div>

        <!-- Add to Bag CTA Button -->
        <div style="display:flex;gap:12px;align-items:center;margin-top:6px">
          <button class="btn btn-blue full" id="dgBuyBtn" type="submit" style="min-height:56px;font-size:18px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px">
            <span>Add to Bag</span>
            <span>·</span>
            <span class="mono" id="dgBuyTotal">${{ current_price }}</span>
          </button>
          <button class="heart" type="button" style="width:56px;height:56px;border:2px solid var(--ink);border-radius:var(--r);display:flex;align-items:center;justify-content:center;background:#fff;cursor:pointer;flex-shrink:0" aria-label="Save to wishlist">
            <svg viewBox="0 0 24 24" width="22" height="22"><path d="M12 20s-7.5-4.6-9.2-9.3C1.6 7.3 3.8 4 7.3 4c2 0 3.5 1.1 4.7 2.8C13.2 5.1 14.7 4 16.7 4c3.5 0 5.7 3.3 4.5 6.7C19.5 15.4 12 20 12 20z" fill="none" stroke="currentColor" stroke-width="2.2"/></svg>
          </button>
        </div>
      </form>

      <!-- PREMIUM SPECIFICATIONS & HIGHLIGHTS ACCORDION MATRIX -->
      <div class="pdp-accordion-group" style="display:flex;flex-direction:column;gap:12px;margin-top:12px">
        
        <!-- Accordion 1: Technical Specifications & Dimensions -->
        <details class="pdp-acc" open style="background:#fff;border:2px solid var(--ink);border-radius:var(--r);box-shadow:var(--sh);overflow:hidden;transition:all .2s ease">
          <summary style="padding:16px;font:700 15px var(--f-head);cursor:pointer;display:flex;justify-content:space-between;align-items:center;background:var(--cloud);user-select:none">
            <span style="display:flex;align-items:center;gap:8px">
              <span>📐</span> Technical Specifications & Dimensions
            </span>
            <span class="acc-icon" style="font-size:18px;font-weight:700">▾</span>
          </summary>
          <div style="padding:16px;border-top:1.5px solid var(--ink)">
            <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:12px;font-size:13.5px">
              <div style="background:var(--paper);padding:10px 12px;border:1px solid var(--rule);border-radius:6px">
                <span style="color:var(--muted);display:block;font-size:11px;text-transform:uppercase;font-weight:700;letter-spacing:0.04em">Model SKU</span>
                <b style="font-size:14px;color:var(--ink)">{{ product.variants.first.sku }}</b>
              </div>
              <div style="background:var(--paper);padding:10px 12px;border:1px solid var(--rule);border-radius:6px">
                <span style="color:var(--muted);display:block;font-size:11px;text-transform:uppercase;font-weight:700;letter-spacing:0.04em">Capacity</span>
                <b style="font-size:14px;color:var(--ink)">{{ product.title | split: 'ml' | first | split: ' ' | last | default: 'Standard' }} ml</b>
              </div>
              <div style="background:var(--paper);padding:10px 12px;border:1px solid var(--rule);border-radius:6px">
                <span style="color:var(--muted);display:block;font-size:11px;text-transform:uppercase;font-weight:700;letter-spacing:0.04em">Material Composition</span>
                <b style="font-size:13.5px;color:var(--ink)">100% High Borosilicate (3.3 Linear Expansion)</b>
              </div>
              <div style="background:var(--paper);padding:10px 12px;border:1px solid var(--rule);border-radius:6px">
                <span style="color:var(--muted);display:block;font-size:11px;text-transform:uppercase;font-weight:700;letter-spacing:0.04em">Thermal Tolerance</span>
                <b style="font-size:13.5px;color:var(--ink)">-20°C to 150°C (-4°F to 302°F)</b>
              </div>
              <div style="background:var(--paper);padding:10px 12px;border:1px solid var(--rule);border-radius:6px">
                <span style="color:var(--muted);display:block;font-size:11px;text-transform:uppercase;font-weight:700;letter-spacing:0.04em">Safety Standards</span>
                <b style="font-size:13.5px;color:var(--ink)">Food Grade · Lead-Free · Cadmium-Free</b>
              </div>
              <div style="background:var(--paper);padding:10px 12px;border:1px solid var(--rule);border-radius:6px">
                <span style="color:var(--muted);display:block;font-size:11px;text-transform:uppercase;font-weight:700;letter-spacing:0.04em">Manufacturing Origin</span>
                <b style="font-size:13.5px;color:var(--ink)">R3 Exports Furnace, Agra, India</b>
              </div>
            </div>
          </div>
        </details>

        <!-- Accordion 2: Thermal Shock & Daily Care -->
        <details class="pdp-acc" style="background:#fff;border:2px solid var(--ink);border-radius:var(--r);box-shadow:var(--sh);overflow:hidden;transition:all .2s ease">
          <summary style="padding:16px;font:700 15px var(--f-head);cursor:pointer;display:flex;justify-content:space-between;align-items:center;background:var(--cloud);user-select:none">
            <span style="display:flex;align-items:center;gap:8px">
              <span>☕</span> Heat Performance & Care Guide
            </span>
            <span class="acc-icon" style="font-size:18px;font-weight:700">▾</span>
          </summary>
          <div style="padding:16px;border-top:1.5px solid var(--ink);font-size:14px;line-height:1.6;color:var(--ink)">
            <ul style="padding-left:18px;margin:0;display:flex;flex-direction:column;gap:8px">
              <li><strong>Hot + Cold Safe:</strong> Pour boiling espresso (100°C) directly over freezing ice cubes (-20°C) without any risk of thermal shock cracking.</li>
              <li><strong>Microwave Safe:</strong> Reheat beverages safely. Borosilicate does not absorb radiation or leach chemicals.</li>
              <li><strong>Dishwasher Proof:</strong> Commercial and domestic dishwasher safe on any cycle. Retains crystal-clear optical brilliance.</li>
              <li><strong>Artisanal Furnace Craft:</strong> Each glass is hand-blown by master glassworkers in Agra; subtle organic variations reflect genuine handmade craft.</li>
            </ul>
          </div>
        </details>

        <!-- Accordion 3: Packaging, US Shipping & Guarantee -->
        <details class="pdp-acc" style="background:#fff;border:2px solid var(--ink);border-radius:var(--r);box-shadow:var(--sh);overflow:hidden;transition:all .2s ease">
          <summary style="padding:16px;font:700 15px var(--f-head);cursor:pointer;display:flex;justify-content:space-between;align-items:center;background:var(--cloud);user-select:none">
            <span style="display:flex;align-items:center;gap:8px">
              <span>📦</span> Packaging, Delivery & Replacement Guarantee
            </span>
            <span class="acc-icon" style="font-size:18px;font-weight:700">▾</span>
          </summary>
          <div style="padding:16px;border-top:1.5px solid var(--ink);font-size:14px;line-height:1.6;color:var(--ink)">
            <ul style="padding-left:18px;margin:0;display:flex;flex-direction:column;gap:8px">
              <li><strong>Drop-Tested Packaging:</strong> Packaged in custom shock-absorbing recycled honeycomb foam engineered to survive standard logistics handling.</li>
              <li><strong>Free US Shipping:</strong> Free standard shipping across the United States on all orders over $75 (delivered in 3–5 business days).</li>
              <li><strong>100% Free Breakage Replacement:</strong> If a glass arrives damaged in transit, simply send us a quick photo within 30 days and we will ship a replacement immediately, zero questions asked.</li>
              <li><strong>B2B Trade & Hospitality:</strong> Master carton quantities available for bars, cafes, and bulk commercial export inquiries.</li>
            </ul>
          </div>
        </details>
      </div>

    </div>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const mainImg = document.getElementById('dgMainImg');
  const qtyInput = document.getElementById('dgPackQtyInput');
  const buyTotal = document.getElementById('dgBuyTotal');
  const priceMain = document.getElementById('dgPriceMain');

  const unitPrice = {{ current_price }};

  function formatUSD(num) {
    return '$' + Math.round(num);
  }

  // Pack selector interactions
  document.querySelectorAll('input[name="pack_radio"]').forEach(function(radio) {
    radio.addEventListener('change', function() {
      document.querySelectorAll('.pack-card').forEach(c => {
        c.classList.remove('on');
        c.style.background = '#fff';
        c.style.borderColor = 'var(--rule)';
      });
      const card = radio.closest('.pack-card');
      card.classList.add('on');
      card.style.background = 'var(--lime-t)';
      card.style.borderColor = 'var(--ink)';

      const qty = parseInt(radio.value, 10);
      if (qtyInput) qtyInput.value = qty;

      let discount = 1.0;
      if (qty === 2) discount = 0.95;
      else if (qty === 4) discount = 0.90;
      else if (qty === 12) discount = 0.85;

      const totalCost = Math.round(unitPrice * qty * discount);
      if (buyTotal) buyTotal.textContent = formatUSD(totalCost);
      if (priceMain) priceMain.textContent = formatUSD(totalCost);
    });
  });

  // Gallery Thumbnails
  document.querySelectorAll('.g-thumb').forEach(function(thumb) {
    thumb.addEventListener('click', function() {
      document.querySelectorAll('.g-thumb').forEach(t => {
        t.style.borderColor = 'var(--rule)';
        t.classList.remove('on');
      });
      thumb.style.borderColor = 'var(--ink)';
      thumb.classList.add('on');
      if (mainImg && thumb.dataset.img) {
        mainImg.src = thumb.dataset.img;
      }
    });
  });

  // Add to cart form AJAX handler
  const form = document.getElementById('dgAddToCartForm');
  const buyBtn = document.getElementById('dgBuyBtn');
  if (form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      const variantId = document.getElementById('dgVariantId')?.value || '{{ product.variants.first.id }}';
      const quantity = parseInt(qtyInput ? qtyInput.value : 1, 10);
      const title = "{{ product.title | escape }}";
      const price = buyTotal ? buyTotal.textContent : formatUSD(unitPrice);
      const img = "{% if product.featured_image %}{{ product.featured_image | image_url: width: 360 }}{% else %}{{ 'r3-r3co240.webp' | asset_url }}{% endif %}";
      const sku = "{{ product.variants.first.sku }}";

      if (window.dgAddToCart) {
        window.dgAddToCart(variantId, quantity, { title, price, img, sku }, buyBtn);
      } else {
        form.submit();
      }
    });
  }
});
</script>

{% schema %}
{
  "name": "DG Main Product",
  "settings": [],
  "presets": [
    {
      "name": "DG Main Product"
    }
  ]
}
{% endschema %}
