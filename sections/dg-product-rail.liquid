<script>
document.addEventListener('DOMContentLoaded', function() {
  const tabs = document.querySelectorAll('#dgRailTabs .tab');
  const rails = {
    new: document.getElementById('rail-new'),
    hero: document.getElementById('rail-hero'),
    under30: document.getElementById('rail-under30')
  };

  tabs.forEach(function(tab) {
    tab.addEventListener('click', function() {
      tabs.forEach(t => {
        t.classList.remove('on');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('on');
      tab.setAttribute('aria-selected', 'true');

      const target = tab.dataset.tab;
      Object.keys(rails).forEach(k => {
        if (rails[k]) {
          rails[k].style.display = (k === target) ? 'grid' : 'none';
        }
      });
    });
  });

  // Swatch switcher logic
  document.querySelectorAll('.swb').forEach(function(swb) {
    swb.addEventListener('click', function(e) {
      e.stopPropagation();
      const parentCard = swb.closest('.pcard');
      if (!parentCard) return;

      parentCard.querySelectorAll('.swb').forEach(b => {
        b.classList.remove('on');
        b.setAttribute('aria-pressed', 'false');
      });
      swb.classList.add('on');
      swb.setAttribute('aria-pressed', 'true');

      const img = parentCard.querySelector('.pcard-img');
      const media = parentCard.querySelector('.pmedia');
      const meta = parentCard.querySelector('.pmeta');

      if (img && swb.dataset.img) img.src = swb.dataset.img;
      if (media && swb.dataset.bg) media.style.setProperty('--bg', swb.dataset.bg);
      if (meta && swb.dataset.color) meta.textContent = 'in ' + swb.dataset.color;
    });
  });
});
</script>

