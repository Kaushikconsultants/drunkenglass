<script>
document.addEventListener('DOMContentLoaded', function() {
  const tabs = document.querySelectorAll('#dgRailTabs .tab');
  const rails = {
    new: document.getElementById('rail-new'),
    hero: document.getElementById('rail-hero'),
    under200: document.getElementById('rail-under200')
  };

  tabs.forEach(function(tab) {
    tab.addEventListener('click', function() {
      tabs.forEach(t => {
        t.classList.remove('on');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('on');
      tab.setAttribute('aria-selected', 'true');

      const target = tab.dataset.tab;
      Object.keys(rails).forEach(k => {
        if (rails[k]) {
          rails[k].style.display = (k === target) ? 'grid' : 'none';
        }
      });
    });
  });
});
</script>

