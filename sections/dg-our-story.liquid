<section class="wrap sec" id="dg-our-story" style="padding-top:16px">
  <header class="page-head" style="margin-bottom:32px">
    <span class="badge b-lime" style="display:inline-block;margin-bottom:8px">our furnace</span>
    <h1 class="h2">we’ve been playing with fire for 15 years.</h1>
    <p class="sub">drunken glass started at our family furnace in india with one mission: make borosilicate glassware that has personality, resists thermal shock, and survives daily life.</p>
  </header>

  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:32px;align-items:center;margin-bottom:48px">
    <div>
      <h3 style="font:700 24px var(--f-head);margin-bottom:12px">built for hot coffee & iced everything</h3>
      <p style="color:var(--muted);font-size:16px;line-height:1.6;margin-bottom:16px">borosilicate glass has a thermal expansion coefficient of just 3.3×10⁻⁶/K. that means you can pour boiling espresso directly over solid ice cubes and it won’t crack.</p>
      <p style="color:var(--muted);font-size:16px;line-height:1.6">unlike soda-lime glass, borosilicate carries zero lead and zero cadmium by nature. it’s the exact same glass used in scientific laboratories and high-end french cookware.</p>
    </div>
    <div style="background:#ffe1e8;border:2px solid var(--ink);border-radius:var(--r);box-shadow:var(--sh);aspect-ratio:4/3;display:flex;align-items:center;justify-content:center;overflow:hidden">
      <img src="{{ 'cherry-bomb--blush.png' | asset_url }}" alt="furnace crafted glass" width="260" height="320" style="object-fit:contain">
    </div>
  </div>

  <!-- 6 Process Steps -->
  <div class="sec-head" style="margin-bottom:20px">
    <div>
      <h2 class="h2">from furnace to your shelf</h2>
      <p class="sub">how every single drunken glass is handcrafted.</p>
    </div>
  </div>

  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px;margin-bottom:48px">
    <div style="background:#fff;border:2px solid var(--ink);border-radius:var(--r);box-shadow:var(--sh);padding:20px">
      <span class="mono" style="font-size:28px;font-weight:700;color:var(--berry);display:block;margin-bottom:6px">01</span>
      <b style="font-size:16px;display:block;margin-bottom:4px">melt</b>
      <p style="color:var(--muted);font-size:14px">raw silica sand and boron oxide heat to 2,900°F (1,600°C) until molten clear.</p>
    </div>
    <div style="background:#fff;border:2px solid var(--ink);border-radius:var(--r);box-shadow:var(--sh);padding:20px">
      <span class="mono" style="font-size:28px;font-weight:700;color:var(--blue);display:block;margin-bottom:6px">02</span>
      <b style="font-size:16px;display:block;margin-bottom:4px">shape</b>
      <p style="color:var(--muted);font-size:14px">skilled glass artisans mouth-blow and press molten bubbles into custom iron molds.</p>
    </div>
    <div style="background:#fff;border:2px solid var(--ink);border-radius:var(--r);box-shadow:var(--sh);padding:20px">
      <span class="mono" style="font-size:28px;font-weight:700;color:var(--ink);display:block;margin-bottom:6px">03</span>
      <b style="font-size:16px;display:block;margin-bottom:4px">anneal</b>
      <p style="color:var(--muted);font-size:14px">hours in the slow-cooling annealing lehr release all internal structural stresses.</p>
    </div>
    <div style="background:#fff;border:2px solid var(--ink);border-radius:var(--r);box-shadow:var(--sh);padding:20px">
      <span class="mono" style="font-size:28px;font-weight:700;color:var(--berry);display:block;margin-bottom:6px">04</span>
      <b style="font-size:16px;display:block;margin-bottom:4px">finish</b>
      <p style="color:var(--muted);font-size:14px">hand-screened mineral color pigments get fired into the glass surface permanently.</p>
    </div>
    <div style="background:#fff;border:2px solid var(--ink);border-radius:var(--r);box-shadow:var(--sh);padding:20px">
      <span class="mono" style="font-size:28px;font-weight:700;color:var(--blue);display:block;margin-bottom:6px">05</span>
      <b style="font-size:16px;display:block;margin-bottom:4px">check</b>
      <p style="color:var(--muted);font-size:14px">thermal shock testing and optical inspection for flawless wall thickness and rim bevel.</p>
    </div>
    <div style="background:#fff;border:2px solid var(--ink);border-radius:var(--r);box-shadow:var(--sh);padding:20px">
      <span class="mono" style="font-size:28px;font-weight:700;color:var(--ink);display:block;margin-bottom:6px">06</span>
      <b style="font-size:16px;display:block;margin-bottom:4px">pack</b>
      <p style="color:var(--muted);font-size:14px">packed in 100% recyclable molded honeycomb pulp ready for free delivery to US doors.</p>
    </div>
  </div>

  <!-- CTA Band -->
  <div style="background:var(--lime);border:2px solid var(--ink);border-radius:var(--r);box-shadow:var(--sh);padding:clamp(28px,5vw,48px);text-align:center">
    <h2 class="h2" style="margin-bottom:8px">Seen Enough? Go Shopping.</h2>
    <p style="color:var(--ink);font-size:16px;margin-bottom:20px">Seven collections of tumblers, coffee cups, teacups and cocktail glasses.</p>
    <a class="btn btn-ink" href="/collections/all">Shop All Glasses</a>
  </div>
</section>

{% schema %}
{
  "name": "DG Our Story",
  "settings": [],
  "presets": [
    {
      "name": "DG Our Story"
    }
  ]
}
{% endschema %}
