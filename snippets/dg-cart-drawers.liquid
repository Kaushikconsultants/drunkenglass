<!-- Background Scrim -->
<div class="scrim" id="dgScrim"></div>

<!-- 1. Added-To-Bag Drawer -->
<aside class="drawer" id="dgAddedDrawer" aria-label="added to bag" aria-hidden="true" style="z-index:999">
  <div class="dhead">
    <h3>added to your bag</h3>
    <button class="close" id="dgCloseAdded" aria-label="close drawer">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>

  <div class="dbody">
    <!-- Item added preview -->
    <div id="dgAddedItemBox" style="display:flex;gap:16px;align-items:center;padding:16px;background:var(--cloud);border:2px solid var(--ink);border-radius:var(--r);margin-bottom:16px">
      <img id="dgAddedImg" src="{{ 'cherry-bomb--blush.png' | asset_url }}" alt="added glass" width="60" height="75" style="border-radius:4px">
      <div>
        <h4 id="dgAddedTitle" style="font:700 16px var(--f-head);margin-bottom:4px">cherry bomb tumbler</h4>
        <span class="pmeta" id="dgAddedMeta" style="font-size:13px;color:var(--muted)">in blush · pair (qty 2)</span>
        <div class="price" id="dgAddedPrice" style="font-weight:700;margin-top:4px">$66</div>
      </div>
    </div>

    <!-- Free Shipping Meter -->
    <div style="background:#fff;border:2px solid var(--ink);border-radius:var(--r);padding:14px;margin-bottom:20px">
      <div style="display:flex;justify-content:space-between;font-size:13px;font-weight:700;margin-bottom:8px">
        <span id="dgShipMeterText">add $9 more for free US shipping</span>
        <span class="mono" id="dgShipGoal">$75</span>
      </div>
      <div style="height:8px;background:var(--cloud);border:1.5px solid var(--ink);border-radius:999px;overflow:hidden">
        <div id="dgShipBar" style="height:100%;width:88%;background:var(--blue);transition:width .3s ease"></div>
      </div>
    </div>

    <!-- Goes well with cross-sells -->
    <div style="margin-bottom:24px">
      <p class="lbl" style="font:700 13px var(--f-head);margin-bottom:10px">goes well with</p>
      <div style="display:grid;gap:10px">
        <div style="display:flex;align-items:center;justify-content:space-between;padding:10px;border:2px solid var(--rule);border-radius:var(--r);background:#fff">
          <div style="display:flex;align-items:center;gap:10px">
            <img src="{{ 'bamboo-lid.png' | asset_url }}" alt="bamboo lid" width="40" height="40">
            <div>
              <b style="font-size:13px;display:block">bamboo lid + straw</b>
              <span class="price" style="font-size:13px">$8</span>
            </div>
          </div>
          <button class="btn btn-lime sm" type="button" style="padding:0 12px;min-height:34px;font-size:13px">+ add</button>
        </div>

        <div style="display:flex;align-items:center;justify-content:space-between;padding:10px;border:2px solid var(--rule);border-radius:var(--r);background:#fff">
          <div style="display:flex;align-items:center;gap:10px">
            <img src="{{ 'coaster-set.png' | asset_url }}" alt="coaster set" width="40" height="40">
            <div>
              <b style="font-size:13px;display:block">silicone coasters (4)</b>
              <span class="price" style="font-size:13px">$16</span>
            </div>
          </div>
          <button class="btn btn-lime sm" type="button" style="padding:0 12px;min-height:34px;font-size:13px">+ add</button>
        </div>
      </div>
    </div>

    <!-- Actions -->
    <div style="display:flex;gap:10px">
      <button class="btn full" id="dgGoToBag" type="button" style="background:#fff">view bag</button>
      <a class="btn btn-blue full" href="/checkout">checkout</a>
    </div>
  </div>
</aside>

<!-- 2. Full Slideout Bag Drawer -->
<aside class="drawer" id="dgCartDrawer" aria-label="your bag" aria-hidden="true" style="z-index:999">
  <div class="dhead">
    <h3>your bag (<span id="dgCartItemsCount">2</span>)</h3>
    <button class="close" id="dgCloseCart" aria-label="close bag">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>

  <div class="dbody">
    <!-- Free Shipping Meter -->
    <div style="background:var(--cloud);border:2px solid var(--ink);border-radius:var(--r);padding:14px;margin-bottom:20px">
      <div style="display:flex;justify-content:space-between;font-size:13px;font-weight:700;margin-bottom:8px">
        <span id="dgBagShipText">free US shipping unlocked! 🎉</span>
        <span class="mono">$75</span>
      </div>
      <div style="height:8px;background:#fff;border:1.5px solid var(--ink);border-radius:999px;overflow:hidden">
        <div style="height:100%;width:100%;background:var(--blue)"></div>
      </div>
    </div>

    <!-- Cart Items List -->
    <div id="dgCartItemsList" style="display:flex;flex-direction:column;gap:14px;margin-bottom:24px">
      <div style="display:flex;gap:12px;align-items:center;border-bottom:1.5px solid var(--hair);padding-bottom:14px">
        <img src="{{ 'cherry-bomb--blush.png' | asset_url }}" alt="item" width="60" height="75" style="border-radius:4px;border:1.5px solid var(--rule)">
        <div style="flex:1">
          <h4 style="font:700 15px var(--f-head);margin-bottom:2px">cherry bomb tumbler</h4>
          <span style="font-size:13px;color:var(--muted)">blush · pair (8% off)</span>
          <div style="display:flex;justify-content:space-between;align-items:center;margin-top:8px">
            <div style="display:inline-flex;border:1.5px solid var(--ink);border-radius:4px;overflow:hidden">
              <button type="button" style="padding:2px 8px;font-weight:700">-</button>
              <span class="mono" style="padding:2px 10px;font-size:13px;background:var(--cloud)">2</span>
              <button type="button" style="padding:2px 8px;font-weight:700">+</button>
            </div>
            <span class="price" style="font-weight:700">$66</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Gift Box & Note Checkbox -->
    <div style="background:#fff;border:2px solid var(--ink);border-radius:var(--r);padding:14px;margin-bottom:20px">
      <label style="display:flex;gap:10px;align-items:center;cursor:pointer;font-weight:700;font-size:14px">
        <input type="checkbox" id="dgGiftBoxToggle" style="width:18px;height:18px;accent-color:var(--blue)">
        <span>add gift box + handwritten note ($9)</span>
      </label>
      <div id="dgGiftNoteArea" style="display:none;margin-top:10px">
        <textarea placeholder="write your note (max 160 characters)" maxlength="160" style="width:100%;height:60px;border:1.5px solid var(--ink);border-radius:4px;padding:8px;font-size:13px;resize:none"></textarea>
      </div>
    </div>

    <!-- Discount Code Input -->
    <div style="display:flex;gap:8px;margin-bottom:20px">
      <input type="text" placeholder="discount code (e.g. SIPSIP10)" style="flex:1;border:2px solid var(--ink);border-radius:var(--r);padding:0 12px;min-height:42px;font:500 13px var(--f-mono)">
      <button class="btn btn-ink sm" type="button" style="min-height:42px">apply</button>
    </div>

    <!-- Totals -->
    <div style="border-top:2px solid var(--ink);padding-top:16px;margin-bottom:20px">
      <div style="display:flex;justify-content:space-between;margin-bottom:6px;font-size:14px">
        <span>subtotal</span>
        <span class="price">$72.00</span>
      </div>
      <div style="display:flex;justify-content:space-between;margin-bottom:6px;font-size:14px">
        <span>shipping</span>
        <span style="color:var(--berry);font-weight:700">free</span>
      </div>
      <div style="display:flex;justify-content:space-between;font-size:18px;font-weight:700;margin-top:10px;border-top:1px dashed var(--rule);padding-top:10px">
        <span>estimated total</span>
        <span class="price">$72.00</span>
      </div>
      <p style="font-size:12px;color:var(--muted);margin-top:4px">sales tax calculated at checkout</p>
    </div>

    <a class="btn btn-blue full" href="/checkout" style="min-height:54px;font-size:17px">checkout securely</a>
    <p style="text-align:center;font-size:12px;color:var(--muted);margin-top:10px">or 4 interest-free payments of $18 with Shop Pay</p>
  </div>
</aside>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const scrim = document.getElementById('dgScrim');
  const addedDrawer = document.getElementById('dgAddedDrawer');
  const cartDrawer = document.getElementById('dgCartDrawer');
  const bagBtn = document.getElementById('dgBagBtn');
  const closeAdded = document.getElementById('dgCloseAdded');
  const closeCart = document.getElementById('dgCloseCart');
  const goToBag = document.getElementById('dgGoToBag');
  const giftToggle = document.getElementById('dgGiftBoxToggle');
  const giftNote = document.getElementById('dgGiftNoteArea');

  function closeAllDrawers() {
    if (addedDrawer) addedDrawer.classList.remove('open');
    if (cartDrawer) cartDrawer.classList.remove('open');
    const mMenu = document.getElementById('dgMobileMenu');
    if (mMenu) mMenu.classList.remove('open');
    if (scrim) scrim.classList.remove('open');
  }

  if (bagBtn) {
    bagBtn.addEventListener('click', function() {
      closeAllDrawers();
      if (cartDrawer) cartDrawer.classList.add('open');
      if (scrim) scrim.classList.add('open');
    });
  }

  if (closeAdded) closeAdded.addEventListener('click', closeAllDrawers);
  if (closeCart) closeCart.addEventListener('click', closeAllDrawers);
  if (scrim) scrim.addEventListener('click', closeAllDrawers);

  if (goToBag) {
    goToBag.addEventListener('click', function() {
      if (addedDrawer) addedDrawer.classList.remove('open');
      if (cartDrawer) cartDrawer.classList.add('open');
    });
  }

  // Quick add trigger across all cards
  document.querySelectorAll('[data-add]').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      closeAllDrawers();
      // Open Added Drawer
      if (addedDrawer) addedDrawer.classList.add('open');
      if (scrim) scrim.classList.add('open');
    });
  });

  if (giftToggle && giftNote) {
    giftToggle.addEventListener('change', function() {
      giftNote.style.display = giftToggle.checked ? 'block' : 'none';
    });
  }
});
</script>
