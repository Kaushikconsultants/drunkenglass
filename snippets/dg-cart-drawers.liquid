<!-- Background Scrim -->
<div class="scrim" id="dgScrim"></div>

<!-- 1. Added-To-Bag Drawer -->
<aside class="drawer dg-drawer" id="dgAddedDrawer" aria-label="Added to Bag" aria-hidden="true" style="z-index:9999">
  <div class="dhead">
    <h3>Added to Your Bag</h3>
    <button class="close" id="dgCloseAdded" aria-label="Close drawer">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>

  <div class="dbody">
    <!-- Item added preview -->
    <div id="dgAddedItemBox" style="display:flex;gap:12px;align-items:center;padding:12px;background:var(--cloud);border:2px solid var(--ink);border-radius:var(--r);margin-bottom:16px;min-width:0;width:100%;box-sizing:border-box">
      <img id="dgAddedImg" src="{{ 'cherry-bomb--blush.png' | asset_url }}" alt="Added Glass" width="56" height="70" style="border-radius:4px;flex-shrink:0;object-fit:contain">
      <div style="flex:1;min-width:0">
        <h4 id="dgAddedTitle" style="font:700 15px var(--f-head);margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">Cherry Bomb Tumbler</h4>
        <span class="pmeta" id="dgAddedMeta" style="font-size:13px;color:var(--muted)">In Blush · Pair (Qty 2)</span>
        <div class="price" id="dgAddedPrice" style="font-weight:700;margin-top:4px;font-size:16px">$66</div>
      </div>
    </div>

    <!-- Free Shipping Meter -->
    <div style="background:#fff;border:2px solid var(--ink);border-radius:var(--r);padding:14px;margin-bottom:18px;box-sizing:border-box">
      <div style="display:flex;justify-content:space-between;font-size:13px;font-weight:700;margin-bottom:8px">
        <span id="dgShipMeterText">Add $9 more for Free US Shipping</span>
        <span class="mono" id="dgShipGoal">$75</span>
      </div>
      <div style="height:8px;background:var(--cloud);border:1.5px solid var(--ink);border-radius:999px;overflow:hidden">
        <div id="dgShipBar" style="height:100%;width:88%;background:var(--blue);transition:width .3s ease"></div>
      </div>
    </div>

    <!-- Goes well with cross-sells -->
    <div style="margin-bottom:20px">
      <p class="lbl" style="font:700 13px var(--f-head);margin-bottom:10px">Goes Well With</p>
      <div style="display:grid;gap:10px">
        <div style="display:flex;align-items:center;justify-content:space-between;padding:10px;border:2px solid var(--rule);border-radius:var(--r);background:#fff;box-sizing:border-box">
          <div style="display:flex;align-items:center;gap:10px;min-width:0">
            <img src="{{ 'bamboo-lid.png' | asset_url }}" alt="Bamboo Lid" width="40" height="40" style="flex-shrink:0">
            <div style="min-width:0">
              <b style="font-size:13px;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">Bamboo Lid + Straw</b>
              <span class="price" style="font-size:13px">$8</span>
            </div>
          </div>
          <button class="btn btn-lime sm" type="button" style="padding:0 12px;min-height:34px;font-size:13px;flex-shrink:0">+ Add</button>
        </div>

        <div style="display:flex;align-items:center;justify-content:space-between;padding:10px;border:2px solid var(--rule);border-radius:var(--r);background:#fff;box-sizing:border-box">
          <div style="display:flex;align-items:center;gap:10px;min-width:0">
            <img src="{{ 'coaster-set.png' | asset_url }}" alt="Coaster Set" width="40" height="40" style="flex-shrink:0">
            <div style="min-width:0">
              <b style="font-size:13px;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">Silicone Coasters (4)</b>
              <span class="price" style="font-size:13px">$16</span>
            </div>
          </div>
          <button class="btn btn-lime sm" type="button" style="padding:0 12px;min-height:34px;font-size:13px;flex-shrink:0">+ Add</button>
        </div>
      </div>
    </div>

    <!-- Actions -->
    <div style="display:flex;gap:10px;margin-top:auto">
      <button class="btn full" id="dgGoToBag" type="button" style="background:#fff">View Bag</button>
      <a class="btn btn-blue full" href="/checkout">Checkout</a>
    </div>
  </div>
</aside>

<!-- 2. Full Slideout Bag Drawer -->
<aside class="drawer dg-drawer" id="dgCartDrawer" aria-label="Your Bag" aria-hidden="true" style="z-index:9999">
  <div class="dhead">
    <h3>Your Bag (<span id="dgCartItemsCount">2</span>)</h3>
    <button class="close" id="dgCloseCart" aria-label="Close bag">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>

  <div class="dbody">
    <!-- Free Shipping Meter -->
    <div style="background:var(--cloud);border:2px solid var(--ink);border-radius:var(--r);padding:14px;margin-bottom:16px;box-sizing:border-box">
      <div style="display:flex;justify-content:space-between;font-size:13px;font-weight:700;margin-bottom:8px">
        <span id="dgBagShipText">Free US Shipping Unlocked! 🎉</span>
        <span class="mono">$75</span>
      </div>
      <div style="height:8px;background:#fff;border:1.5px solid var(--ink);border-radius:999px;overflow:hidden">
        <div style="height:100%;width:100%;background:var(--blue)"></div>
      </div>
    </div>

    <!-- Cart Items List -->
    <div id="dgCartItemsList" style="display:flex;flex-direction:column;gap:14px;margin-bottom:20px;width:100%">
      <div style="display:flex;gap:12px;align-items:center;border-bottom:1.5px solid var(--hair);padding-bottom:14px;padding-right:10px;width:100%;min-width:0;box-sizing:border-box">
        <img src="{{ 'cherry-bomb--blush.png' | asset_url }}" alt="Item" width="56" height="70" style="border-radius:4px;border:1.5px solid var(--rule);flex-shrink:0;object-fit:contain">
        <div style="flex:1;min-width:0;display:flex;flex-direction:column;gap:3px">
          <h4 style="font:700 15px var(--f-head);margin:0;line-height:1.25">Cherry Bomb Tumbler</h4>
          <span style="font-size:13px;color:var(--muted)">Blush · Pair (8% Off)</span>
          <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;margin-top:6px;width:100%">
            <div style="display:inline-flex;border:1.5px solid var(--ink);border-radius:4px;overflow:hidden;flex-shrink:0">
              <button type="button" style="padding:2px 8px;font-weight:700" aria-label="Decrease quantity">-</button>
              <span class="mono" style="padding:2px 8px;font-size:13px;background:var(--cloud)">2</span>
              <button type="button" style="padding:2px 8px;font-weight:700" aria-label="Increase quantity">+</button>
            </div>
            <span class="price" style="font-weight:700;font-size:16px;flex-shrink:0;white-space:nowrap;margin-left:auto;padding-right:8px">$66</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Gift Box & Note Checkbox -->
    <div style="background:#fff;border:2px solid var(--ink);border-radius:var(--r);padding:14px;margin-bottom:16px;box-sizing:border-box">
      <label style="display:flex;gap:10px;align-items:center;cursor:pointer;font-weight:700;font-size:13.5px;line-height:1.3">
        <input type="checkbox" id="dgGiftBoxToggle" style="width:18px;height:18px;accent-color:var(--blue);flex-shrink:0">
        <span>Add Gift Box + Handwritten Note ($9)</span>
      </label>
      <div id="dgGiftNoteArea" style="display:none;margin-top:10px">
        <textarea placeholder="Write your note (max 160 characters)" maxlength="160" style="width:100%;height:60px;border:1.5px solid var(--ink);border-radius:4px;padding:8px;font-size:13px;resize:none;box-sizing:border-box"></textarea>
      </div>
    </div>

    <!-- Discount Code Input -->
    <div style="display:flex;gap:8px;margin-bottom:18px;width:100%;box-sizing:border-box">
      <input type="text" placeholder="Discount code (e.g. SIPSIP10)" style="flex:1;min-width:0;width:100%;border:2px solid var(--ink);border-radius:var(--r);padding:0 12px;min-height:42px;font:500 13px var(--f-mono);box-sizing:border-box">
      <button class="btn btn-ink sm" type="button" style="min-height:42px;flex-shrink:0;padding:0 16px">Apply</button>
    </div>

    <!-- Totals -->
    <div style="border-top:2px solid var(--ink);padding-top:16px;margin-bottom:18px;box-sizing:border-box">
      <div style="display:flex;justify-content:space-between;margin-bottom:6px;font-size:14px">
        <span>Subtotal</span>
        <span class="price">$72.00</span>
      </div>
      <div style="display:flex;justify-content:space-between;margin-bottom:6px;font-size:14px">
        <span>Shipping</span>
        <span style="color:var(--berry);font-weight:700">Free</span>
      </div>
      <div style="display:flex;justify-content:space-between;font-size:18px;font-weight:700;margin-top:10px;border-top:1px dashed var(--rule);padding-top:10px">
        <span>Estimated Total</span>
        <span class="price">$72.00</span>
      </div>
      <p style="font-size:12px;color:var(--muted);margin-top:4px">Sales tax calculated at checkout</p>
    </div>

    <a class="btn btn-blue full" href="/checkout" style="min-height:50px;font-size:16px;box-sizing:border-box">Checkout Securely</a>
    <p style="text-align:center;font-size:12px;color:var(--muted);margin-top:8px">Or 4 interest-free payments of $18 with Shop Pay</p>
  </div>
</aside>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const scrim = document.getElementById('dgScrim');
  const addedDrawer = document.getElementById('dgAddedDrawer');
  const cartDrawer = document.getElementById('dgCartDrawer');
  const bagBtn = document.getElementById('dgBagBtn');
  const closeAdded = document.getElementById('dgCloseAdded');
  const closeCart = document.getElementById('dgCloseCart');
  const goToBag = document.getElementById('dgGoToBag');
  const giftToggle = document.getElementById('dgGiftBoxToggle');
  const giftNote = document.getElementById('dgGiftNoteArea');

  function closeAllDrawers() {
    if (addedDrawer) addedDrawer.classList.remove('open');
    if (cartDrawer) cartDrawer.classList.remove('open');
    const mMenu = document.getElementById('dgMobileMenu');
    if (mMenu) mMenu.classList.remove('open');
    if (scrim) scrim.classList.remove('open');
  }

  if (bagBtn) {
    bagBtn.addEventListener('click', function() {
      closeAllDrawers();
      if (cartDrawer) cartDrawer.classList.add('open');
      if (scrim) scrim.classList.add('open');
    });
  }

  if (closeAdded) closeAdded.addEventListener('click', closeAllDrawers);
  if (closeCart) closeCart.addEventListener('click', closeAllDrawers);
  if (scrim) scrim.addEventListener('click', closeAllDrawers);

  if (goToBag) {
    goToBag.addEventListener('click', function() {
      if (addedDrawer) addedDrawer.classList.remove('open');
      if (cartDrawer) cartDrawer.classList.add('open');
    });
  }

  // Quick add trigger across all cards
  document.querySelectorAll('[data-add]').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      closeAllDrawers();
      if (addedDrawer) addedDrawer.classList.add('open');
      if (scrim) scrim.classList.add('open');
    });
  });

  if (giftToggle && giftNote) {
    giftToggle.addEventListener('change', function() {
      giftNote.style.display = giftToggle.checked ? 'block' : 'none';
    });
  }
});
</script>
